Функция ПолучитьОборотыПоПлатежнымКартам(СтруктураПараметров)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ХозрасчетныйОбороты.Регистратор.Контрагент КАК Контрагент,
		|	СУММА(ВЫБОР
		|			КОГДА ХозрасчетныйОбороты.КорСчет В (&Счет76)
		|				ТОГДА ХозрасчетныйОбороты.СуммаОборот
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК СуммаПлатежа,
		|	СУММА(ВЫБОР
		|			КОГДА ХозрасчетныйОбороты.КорСчет = &Счет91
		|				ТОГДА ХозрасчетныйОбороты.СуммаОборот
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК Комиссия,
		|	СУММА(ХозрасчетныйОбороты.СуммаОборот) КАК СуммаОбщая,
		|	ЕСТЬNULL(КодВодителяКонтрагента.Значение, """") КАК КодВодителя
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.Обороты(&НачалоПериода, &ОкончаниеПериода, Регистратор, Счет = &Счет57_3, , , , ) КАК ХозрасчетныйОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК КодВодителяКонтрагента
		|		ПО ХозрасчетныйОбороты.Регистратор.Контрагент = КодВодителяКонтрагента.Объект
		|			И (КодВодителяКонтрагента.Свойство.Наименование = ""КодВодителя"")
		|ГДЕ
		|	ХозрасчетныйОбороты.Регистратор ССЫЛКА Документ.ОплатаПлатежнойКартой
		|
		|СГРУППИРОВАТЬ ПО
		|	ХозрасчетныйОбороты.Регистратор.Контрагент,
		|	ЕСТЬNULL(КодВодителяКонтрагента.Значение, """")";
	
	МассивСчетов = Новый Массив;
	МассивСчетов.Добавить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("76.06"));
	МассивСчетов.Добавить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("76.05"));
	
	Запрос.УстановитьПараметр("НачалоПериода", 		СтруктураПараметров.ДатаНачала);
	Запрос.УстановитьПараметр("ОкончаниеПериода", 	КонецДня(СтруктураПараметров.ДатаОкончания));
	Запрос.УстановитьПараметр("Счет57_3", 			ПланыСчетов.Хозрасчетный.НайтиПоКоду("57.03"));
	Запрос.УстановитьПараметр("Счет91", 			ПланыСчетов.Хозрасчетный.НайтиПоКоду("91.01"));
	Запрос.УстановитьПараметр("Счет76", 			МассивСчетов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТаблицаЗапроса = РезультатЗапроса.Выгрузить();
	
	//ТаблицаДляСвертки = ТаблицаЗапроса.Скопировать(, "СуммаОборот");
	//ТаблицаДляСвертки.Свернуть( , "СуммаОборот");
	
	Результат = Новый Структура();
	Результат.Вставить("ОборотыПоКонтрагентам", 	ПреобразоватьТаблицуВМассивСтрокДляВыгрузки(ТаблицаЗапроса, Истина));
	//Результат.Вставить("ОборотыПоСчету57_03",		ТаблицаДляСвертки[0].СуммаОборот);
	
	Возврат Результат;
	
КонецФункции
