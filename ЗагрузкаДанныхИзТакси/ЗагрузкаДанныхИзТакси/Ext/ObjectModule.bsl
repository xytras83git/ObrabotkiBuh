Функция ПолучитьОстаткиОбороты(СтруктураОтбора)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ХозрасчетныйОстаткиИОбороты.Субконто1 КАК Контрагент,
		|	Контрагенты.Наименование КАК ВодительНаименование,
		|	ВЫБОР
		|		КОГДА ХозрасчетныйОстаткиИОбороты.Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетыСПрочимиПокупателямиИЗаказчиками)
		|			ТОГДА ""Аренда""
		|		КОГДА ХозрасчетныйОстаткиИОбороты.Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПрочиеРасчетыСРазнымиДебиторамиИКредиторами)
		|			ТОГДА ""Франшиза""
		|	КОНЕЦ КАК Статья,
		|	ХозрасчетныйОстаткиИОбороты.СуммаНачальныйОстаток КАК СуммаНачальныйОстаток,
		|	ХозрасчетныйОстаткиИОбороты.СуммаОборотДт КАК СуммаОборотДт,
		|	ХозрасчетныйОстаткиИОбороты.СуммаОборотКт КАК СуммаОборотКт,
		|	ХозрасчетныйОстаткиИОбороты.СуммаКонечныйОстаток КАК СуммаКонечныйОстаток,
		|	ЕСТЬNULL(КодВодителяКонтрагента.Значение, """") КАК КодВодителя
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(&НачалоПериода, КонецПериода(&ОкончаниеПериода, День), , , Счет В (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетыСПрочимиПокупателямиИЗаказчиками), ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПрочиеРасчетыСРазнымиДебиторамиИКредиторами)), , Организация = &Организация) КАК ХозрасчетныйОстаткиИОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
		|		ПО ХозрасчетныйОстаткиИОбороты.Субконто1 = Контрагенты.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК КодВодителяКонтрагента
		|		ПО ХозрасчетныйОстаткиИОбороты.Субконто1 = КодВодителяКонтрагента.Объект
		|			И (КодВодителяКонтрагента.Свойство.Наименование = ""КодВодителя"")
		|ГДЕ
		|	(НЕ Контрагенты.Ссылка ЕСТЬ NULL
		|				И Контрагенты.Ссылка = &Контрагент
		|			ИЛИ &Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВодительНаименование";
	
	Запрос.УстановитьПараметр("НачалоПериода", 		СтруктураОтбора.ДатаНачала);
	Запрос.УстановитьПараметр("ОкончаниеПериода", 	КонецДня(СтруктураОтбора.ДатаОкончания));
	Запрос.УстановитьПараметр("Организация", 		СтруктураОтбора.Организация);
	Запрос.УстановитьПараметр("Контрагент", 		Справочники.Контрагенты.ПустаяСсылка());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	МассивОтветов = Новый Массив;
	Пока Выборка.Следующий() Цикл
		
		СтруктураСверка = Новый Структура("Статья, ВодительНаименование, СуммаНачальныйОстаток, СуммаКонечныйОстаток, СуммаОборотДт, СуммаОборотКт, КодВодителя");
		ЗаполнитьЗначенияСвойств(СтруктураСверка, Выборка);  
		МассивОтветов.Добавить(СтруктураСверка);
		
	КонецЦикла; 
	
	Возврат МассивОтветов;

КонецФункции

