Функция ПолучитьСписокПользователей(СтруктураПараметров)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Пользователи.Наименование КАК Пользователь,
		|	Пользователи.Недействителен КАК Недействителен,
		|	Пользователи.ИдентификаторПользователяИБ КАК ИдентификаторПользователяИБ
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|ГДЕ
		|	НЕ Пользователи.Служебный";
	
	РезультатЗапроса = Запрос.Выполнить();
		
	ТаблицаПользователей = РезультатЗапроса.Выгрузить();	
	
	ТаблицаПользователей.Колонки.Добавить("ВходВБазуРазрешен", 			Новый ОписаниеТипов("Булево"));
	ТаблицаПользователей.Колонки.Добавить("ПолноеИмя", 					Новый ОписаниеТипов("Строка"));
	
	Для каждого СтрокаТаблицы из ТаблицаПользователей Цикл
		ПрочитанныеСвойства = Пользователи.СвойстваПользователяИБ(СтрокаТаблицы.ИдентификаторПользователяИБ);
		Если НЕ ПрочитанныеСвойства = Неопределено Тогда
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ПрочитанныеСвойства, "ПолноеИмя");
			СтрокаТаблицы.ВходВБазуРазрешен = Пользователи.ВходВПрограммуРазрешен(ПрочитанныеСвойства);		
		КонецЕсли;		
	КонецЦикла;
		
	Результат = Новый Структура();
	Результат.Вставить("ТаблицаПользователей", ПреобразоватьТаблицуВМассивСтрокДляВыгрузки(ТаблицаПользователей, Истина));
	
	ПолучатьПрофили = БезопасноеПолучениеСвойстваСтруктуры(СтруктураПараметров, "ПолучатьПрофили", Ложь);
	
	Если ПолучатьПрофили Тогда 
		ПрофилиПользователей = ПолучитьПрофилиПользователей();
		Результат.Вставить("ПрофилиПользователей", ПреобразоватьТаблицуВМассивСтрокДляВыгрузки(ПрофилиПользователей, Истина));
	КонецЕсли;
	
	Возврат Результат;
КонецФункции 

Функция ПолучитьПрофилиПользователей()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Пользователи.Ссылка КАК ПользовательСсылка,
		|	Пользователи.ИдентификаторПользователяИБ КАК ИдентификаторПользователяИБ,
		|	Пользователи.Наименование КАК ИмяПользователя
		|ПОМЕСТИТЬ ВТ_Пользователи
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|ГДЕ
		|	НЕ Пользователи.Служебный
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПрофилиГруппДоступа.Ссылка КАК Профиль,
		|	ПрофилиГруппДоступа.Наименование КАК ИмяПрофиля,
		|	ПрофилиГруппДоступа.ИдентификаторПоставляемыхДанных КАК ИдентификаторПоставляемыхДанных
		|ПОМЕСТИТЬ ВТ_ТаблицаПрофилей
		|ИЗ
		|	Справочник.ПрофилиГруппДоступа КАК ПрофилиГруппДоступа
		|ГДЕ
		|	НЕ ПрофилиГруппДоступа.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Пользователи.ПользовательСсылка КАК ПользовательСсылка,
		|	ВТ_Пользователи.ИмяПользователя КАК ИмяПользователя,
		|	ПрофилиГруппДоступа.Ссылка КАК ПрофильДоступа,
		|	ВТ_Пользователи.ИдентификаторПользователяИБ КАК ИдентификаторПользователяИБ
		|ПОМЕСТИТЬ ВТ_ВключенныеПрофили
		|ИЗ
		|	ВТ_Пользователи КАК ВТ_Пользователи
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГруппыДоступа.Пользователи КАК ГруппыДоступаПользователи
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГруппыДоступа КАК ГруппыДоступа
		|				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПрофилиГруппДоступа КАК ПрофилиГруппДоступа
		|				ПО ГруппыДоступа.Профиль = ПрофилиГруппДоступа.Ссылка
		|			ПО ГруппыДоступаПользователи.Ссылка = ГруппыДоступа.Ссылка
		|		ПО ВТ_Пользователи.ПользовательСсылка = ГруппыДоступаПользователи.Пользователь
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Пользователи.ПользовательСсылка КАК ПользовательСсылка,
		|	ВТ_Пользователи.ИдентификаторПользователяИБ КАК ИдентификаторПользователяИБ,
		|	ВТ_ТаблицаПрофилей.Профиль КАК Профиль,
		|	ВТ_ТаблицаПрофилей.ИмяПрофиля КАК ИмяПрофиля
		|ПОМЕСТИТЬ ВТ_ВсеПрофили
		|ИЗ
		|	ВТ_Пользователи КАК ВТ_Пользователи,
		|	ВТ_ТаблицаПрофилей КАК ВТ_ТаблицаПрофилей
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ВсеПрофили.ПользовательСсылка КАК ПользовательСсылка,
		|	ВТ_ВсеПрофили.ИдентификаторПользователяИБ КАК ИдентификаторПользователяИБ,
		|	ВТ_ВсеПрофили.Профиль КАК Профиль,
		|	ВЫБОР
		|		КОГДА ВТ_ВключенныеПрофили.ПрофильДоступа ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК Выбран,
		|	ВТ_ВсеПрофили.ИмяПрофиля КАК ИмяПрофиля
		|ИЗ
		|	ВТ_ВсеПрофили КАК ВТ_ВсеПрофили
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ВключенныеПрофили КАК ВТ_ВключенныеПрофили
		|		ПО ВТ_ВсеПрофили.ИдентификаторПользователяИБ = ВТ_ВключенныеПрофили.ИдентификаторПользователяИБ
		|			И ВТ_ВсеПрофили.Профиль = ВТ_ВключенныеПрофили.ПрофильДоступа";
	
	РезультатЗапроса = Запрос.Выполнить();
		
	ПрофилиПользователей = РезультатЗапроса.Выгрузить();	
	
	Возврат ПрофилиПользователей;	
	
КонецФункции

