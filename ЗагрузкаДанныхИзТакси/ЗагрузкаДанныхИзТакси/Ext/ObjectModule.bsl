		//Результат.Вставить("Организация", 		Строка(Организация));
		Результат.Вставить("ТаблицаРезультат", 	ПреобразоватьТаблицуВМассивСтрокДляВыгрузки(РезультатЗапроса.Выгрузить(), Истина));
	Исключение
		Возврат Новый СТруктура("Ошибка", ОписаниеОшибки());
	КонецПопытки;
	Возврат	Результат;	
