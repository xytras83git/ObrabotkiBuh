#region ЗагрузкаЭквайринга
Функция ПолучитьДокументыЭквайрингаЗаПериод(СтруктураПараметров)
	
	Если СтруктураПараметров.Свойство("ДатаНачала") Тогда

		СтруктураОтвета = Новый Структура();
		СтруктураОтвета.Вставить("ДатаНачала", Строка(СтруктураПараметров.ДатаНачала));
		СтруктураОтвета.Вставить("ДатаОкончания", Строка(СтруктураПараметров.ДатаОкончания));
		
		Попытка
		
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	ОплатаПлатежнойКартой.Номер КАК Номер,
				|	ОплатаПлатежнойКартой.Дата КАК Дата,
				|	ОплатаПлатежнойКартой.ВидОперации КАК ВидОперации,
				|	ЕСТЬNULL(ОплатаПлатежнойКартойРасшифровкаПлатежа.СуммаПлатежа, 0) КАК СуммаДокумента,
				|	ОплатаПлатежнойКартой.Контрагент.Наименование КАК КонтрагентНаименование,
				|	ЕСТЬNULL(ДополнительныеСведения.Значение, """") КАК Транзакция,
				|	ОплатаПлатежнойКартой.Ссылка КАК Ссылка,
				|	ОплатаПлатежнойКартой.ВидОплаты КАК ВидОплаты,
				|	ЕСТЬNULL(ОплатаПлатежнойКартойРасшифровкаПлатежа.СчетУчетаРасчетовСКонтрагентом, ""00"") КАК СчетУчетаРасчетовСКонтрагентом,
				|	ЕСТЬNULL(КодВодителяКонтрагента.Значение, """") КАК КодВодителя
				|ИЗ
				|	Документ.ОплатаПлатежнойКартой КАК ОплатаПлатежнойКартой
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
				|		ПО ОплатаПлатежнойКартой.Ссылка = ДополнительныеСведения.Объект
				|			И (ДополнительныеСведения.Свойство.Наименование = ""Транзакция"")
				|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОплатаПлатежнойКартой.РасшифровкаПлатежа КАК ОплатаПлатежнойКартойРасшифровкаПлатежа
				|		ПО ОплатаПлатежнойКартой.Ссылка = ОплатаПлатежнойКартойРасшифровкаПлатежа.Ссылка
				|			И (ОплатаПлатежнойКартойРасшифровкаПлатежа.НомерСтроки = 1)
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК КодВодителяКонтрагента
				|		ПО ОплатаПлатежнойКартой.Контрагент = КодВодителяКонтрагента.Объект
				|			И (КодВодителяКонтрагента.Свойство.Наименование = ""КодВодителя"")
				|ГДЕ
				|	ОплатаПлатежнойКартой.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
				|	И ОплатаПлатежнойКартой.Проведен";
			
			Запрос.УстановитьПараметр("ДатаНачала", 	СтруктураПараметров.ДатаНачала);
			Запрос.УстановитьПараметр("ДатаОкончания", 	КонецДня(СтруктураПараметров.ДатаОкончания));
			
			РезультатЗапроса = Запрос.Выполнить();
			
			Выборка = РезультатЗапроса.Выбрать();
			
			МассивДокументов = Новый Массив;
			
			Пока Выборка.Следующий() Цикл		
				СтруктураДокумент = Новый Структура("Номер, СуммаДокумента, КонтрагентНаименование, Транзакция, КодВодителя");
				ЗаполнитьЗначенияСвойств(СтруктураДокумент, Выборка);  
				СтруктураДокумент.Вставить("Дата", 								Строка(Выборка.Дата));
				СтруктураДокумент.Вставить("ВидОперации", 						Строка(Выборка.ВидОперации));
				СтруктураДокумент.Вставить("ВидОплаты", 						Строка(Выборка.ВидОплаты));
				СтруктураДокумент.Вставить("СчетУчетаРасчетовСКонтрагентом", 	Строка(Выборка.СчетУчетаРасчетовСКонтрагентом));
				МассивДокументов.Добавить(СтруктураДокумент);
			КонецЦикла;	
		Исключение 
			СтруктураОтвета.Вставить("Соообщение", "Ошибка в запросе эквайринга");
			Возврат СтруктураОтвета;
		КонецПопытки;
		//СтруктураОтвета = Новый Структура();
		СтруктураОтвета.Вставить("Статус"					, "Истина"); 
		СтруктураОтвета.Вставить("ДатаЗапретаИзменения"		, Строка(ПолучитьДатуЗапретаИзменения()));
		СтруктураОтвета.Вставить("Количество"				, МассивДокументов.Количество());
		СтруктураОтвета.Вставить("МассивЭквайринг"			, МассивДокументов); 
		
		СкопироватьСвойстваСтруктуры(СтруктураОтвета, ПолучитьОборотыПоПлатежнымКартам(СтруктураПараметров));
		
		//СтруктураОтвета.Вставить("ОборотыПоСчету57_03"		, ПолучитьОборотыПоПлатежнымКартам(СтруктураПараметров));
			
		Возврат СтруктураОтвета;
		
	КонецЕсли;
	
	СтруктураОтвета = Новый Структура();
	СтруктураОтвета.Вставить("ТестовыйПараметр", "ДокументыЭквайринг2");
		
	Возврат СтруктураОтвета;
	
КонецФункции

Функция ПоискДокументаЭквайринга(СтруктураДокумент, ДатаДокумента, ТаблицаКонтрагентов = Неопределено)
	
	//Шихалиев Т.Р. 21.05.2026++
	КонтрагентПоиска = Справочники.Контрагенты.ПустаяСсылка();
	Если НЕ ТаблицаКонтрагентов = Неопределено Тогда
		КодВодителя = "";
		Если СтруктураДокумент.Свойство("КодВодителя") Тогда
			КодВодителя = СтруктураДокумент.КодВодителя;
		КонецЕсли;
		СтруктураКонтрагент = НовыйПоискКонтрагентовИДоговоров(СтруктураДокумент.ВодительНаименование, КодВодителя, ТаблицаКонтрагентов);
		Если ЗначениеЗаполнено(СтруктураКонтрагент.Контрагент) Тогда
			КонтрагентПоиска = СтруктураКонтрагент.Контрагент;
		КонецЕсли;
	КонецЕсли;
	//Шихалиев Т.Р. 21.05.2026--
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОплатаПлатежнойКартой.Номер КАК Номер,
		|	ОплатаПлатежнойКартой.Дата КАК Дата,
		|	ОплатаПлатежнойКартой.ВидОперации КАК ВидОперации,
		|	ЕСТЬNULL(ОплатаПлатежнойКартойРасшифровкаПлатежа.СуммаПлатежа, 0) КАК СуммаДокумента,
		|	ОплатаПлатежнойКартой.Контрагент.Наименование КАК КонтрагентНаименование,
		|	ОплатаПлатежнойКартой.Ссылка КАК Ссылка,
		|	ЕСТЬNULL(ДополнительныеСведенияТранзакция.Значение, """") КАК Транзакция,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ДополнительныеСведенияТранзакция.Значение, """") = &ТранзакцияПоиска
		|			ТОГДА 0
		|		КОГДА ЕСТЬNULL(ДополнительныеСведенияТранзакция.Значение, """") = """"
		|			ТОГДА 1
		|		ИНАЧЕ 2
		|	КОНЕЦ КАК ПриоритетПоиска
		|ПОМЕСТИТЬ ВТ_ДокументыОтобранные
		|ИЗ
		|	Документ.ОплатаПлатежнойКартой КАК ОплатаПлатежнойКартой
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОплатаПлатежнойКартой.РасшифровкаПлатежа КАК ОплатаПлатежнойКартойРасшифровкаПлатежа
		|		ПО ОплатаПлатежнойКартой.Ссылка = ОплатаПлатежнойКартойРасшифровкаПлатежа.Ссылка
		|			И (ОплатаПлатежнойКартойРасшифровкаПлатежа.НомерСтроки = 1)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведенияТранзакция
		|		ПО ОплатаПлатежнойКартой.Ссылка = ДополнительныеСведенияТранзакция.Объект
		|			И (ДополнительныеСведенияТранзакция.Свойство.Наименование = ""Транзакция"")
		|ГДЕ
		|	ОплатаПлатежнойКартой.Дата = &ДатаДокумента
		|	И ОплатаПлатежнойКартой.ПометкаУдаления = ЛОЖЬ
		|	И (&КонтрагентПоискаЗаполнен = ИСТИНА
		|			И ОплатаПлатежнойКартой.Контрагент = &КонтрагентПоиска
		|		ИЛИ &КонтрагентПоискаЗаполнен = ЛОЖЬ
		|			И ОплатаПлатежнойКартой.Контрагент.Наименование = &Контрагент)
		|	И ОплатаПлатежнойКартой.ВидОплаты = &ВидОплаты
		|	И (&ТранзакцияПоиска = """"
		|			ИЛИ ЕСТЬNULL(ДополнительныеСведенияТранзакция.Значение, """") = &ТранзакцияПоиска
		|			ИЛИ ЕСТЬNULL(ДополнительныеСведенияТранзакция.Значение, """") = """")
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ДокументыОтобранные.Ссылка КАК Ссылка
		|ИЗ
		|	ВТ_ДокументыОтобранные КАК ВТ_ДокументыОтобранные
		|ГДЕ
		|	ВТ_ДокументыОтобранные.СуммаДокумента = &СуммаДокумента
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВТ_ДокументыОтобранные.ПриоритетПоиска";
		
		
	Запрос.УстановитьПараметр("ДатаДокумента", 	ДатаДокумента);
	Запрос.УстановитьПараметр("Контрагент", 	СтруктураДокумент.ВодительНаименование);
	Запрос.УстановитьПараметр("КонтрагентПоиска", 	КонтрагентПоиска);
	Запрос.УстановитьПараметр("КонтрагентПоискаЗаполнен", ЗначениеЗаполнено(КонтрагентПоиска));
	Запрос.УстановитьПараметр("СуммаДокумента", СтруктураДокумент.СуммаПлатежа);
	Запрос.УстановитьПараметр("ВидОплаты", 		Справочники.ВидыОплатОрганизаций.НайтиПоНаименованию(СтруктураДокумент.ВидОплаты, Истина));
	//Шихалиев Т.Р. 23.06.2026++
	ТранзакцияПоиска = "";
	Если СтруктураДокумент.Свойство("ТранзакцияТакси") Тогда
		ТранзакцияПоиска = СтруктураДокумент.ТранзакцияТакси;
	ИначеЕсли СтруктураДокумент.Свойство("Транзакция") Тогда
		ТранзакцияПоиска = СтруктураДокумент.Транзакция;
	КонецЕсли;
	Запрос.УстановитьПараметр("ТранзакцияПоиска", ТранзакцияПоиска);
	//Шихалиев Т.Р. 23.06.2026--

	//Шихалиев Т.Р. 29.06.2026++
	// Транзакция заполнена - ищем глобально по транзакции (без привязки к дате),
	// чтобы точное время документа не мешало найти уже существующий документ.
	Если ЗначениеЗаполнено(ТранзакцияПоиска) Тогда
		ЗапросТр = Новый Запрос;
		ЗапросТр.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ВЫРАЗИТЬ(ДополнительныеСведения.Объект КАК Документ.ОплатаПлатежнойКартой) КАК Ссылка
			|ИЗ
			|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
			|ГДЕ
			|	ДополнительныеСведения.Свойство.Наименование = ""Транзакция""
			|	И ВЫРАЗИТЬ(ДополнительныеСведения.Значение КАК СТРОКА(50)) = &Транзакция
			|	И ТИПЗНАЧЕНИЯ(ДополнительныеСведения.Объект) = ТИП(Документ.ОплатаПлатежнойКартой)
			|	И НЕ ВЫРАЗИТЬ(ДополнительныеСведения.Объект КАК Документ.ОплатаПлатежнойКартой).ПометкаУдаления";
		ЗапросТр.УстановитьПараметр("Транзакция", ТранзакцияПоиска);
		РезТр = ЗапросТр.Выполнить();
		Если НЕ РезТр.Пустой() Тогда
			ВыборкаТр = РезТр.Выбрать();
			ВыборкаТр.Следующий();
			Возврат ВыборкаТр.Ссылка;
		КонецЕсли;
	КонецЕсли;
	//Шихалиев Т.Р. 29.06.2026--

	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Документы.ОплатаПлатежнойКартой.ПустаяСсылка();
	
КонецФункции

//Шихалиев Т.Р. 02.07.2026 НЕ ИСПОЛЬЗУЕТСЯ (мёртвый код): рабочий поток создания идёт через ЗаполнитьДокументЭквайринга.
//Оставлено для истории. Внимание: здесь в ДопСведения пишется Транзакция, а не ТранзакцияТакси (расхождение с поиском).
Функция СоздатьДокументЭквайринга(СтруктураДокумент, ТаблицаКонтрагентов)
	
	Результат = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(СтруктураДокумент);
	
	ДатаДокумента = ДатаИзСтроки(СтруктураДокумент.ДатаДокумента);
	
	Если НЕ ТипЗнч(ДатаДокумента) = Тип("Дата") Тогда
		Возврат Новый Структура("Статус, Сообщение", "Ложь", "Не удалось распознать дату документа!");
	ИначеЕсли Год(ДатаДокумента) < 2020 Тогда
		Возврат Новый Структура("Статус, Сообщение, ДатаДок", "Ложь", "Некорректная дата документа!", Строка(ДатаДокумента));
	КонецЕсли;
	
	Попытка
		ДокументСсылка = ПоискДокументаЭквайринга(СтруктураДокумент, ДатаДокумента, ТаблицаКонтрагентов);
	Исключение
	    Возврат Новый Структура("Статус, Сообщение", "Ложь", "Ошибка при поиске документа");
	КонецПопытки;
		
	Если ЗначениеЗаполнено(ДокументСсылка) Тогда
		ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
	Иначе
		ДокументОбъект = Документы.ОплатаПлатежнойКартой.СоздатьДокумент();		
	КонецЕсли;

	ДокументОбъект.Дата = ДатаДокумента;
	
	ДокументОбъект.ВидОперации		= Перечисления.ВидыОперацийОплатаПлатежнойКартой.ОплатаПокупателя;
	ДокументОбъект.ВалютаДокумента	= Константы.ВалютаРегламентированногоУчета.Получить();
	ТекущаяОрганизация = Справочники.Организации.Выбрать();
	ТекущаяОрганизация.Следующий();
	
	
	//Шихалиев Т.Р. 21.05.2026++
	КодВодителя = "";
	Если СтруктураДокумент.Свойство("КодВодителя") Тогда
		КодВодителя = СтруктураДокумент.КодВодителя;
	КонецЕсли;
	//СтруктураКонтрагент = СоздатьСправочникКонтрагентов(СтруктураДокумент.ВодительНаименование);
	СтруктураКонтрагент = НовыйПоискКонтрагентовИДоговоров(СтруктураДокумент.ВодительНаименование, КодВодителя, ТаблицаКонтрагентов);
	//Шихалиев Т.Р. 21.05.2026--
	
	ДокументОбъект.Контрагент 		= СтруктураКонтрагент.Контрагент;
	ДокументОбъект.Организация		= ТекущаяОрганизация.ссылка;
	ДокументОбъект.Комментарий		= "Перенос из такси новый";
	ДокументОбъект.СтавкаНДС		= Перечисления.СтавкиНДС.БезНДС;
	
	ДокументОбъект.ВидОплаты = Справочники.ВидыОплатОрганизаций.НайтиПоНаименованию(СтруктураДокумент.ВидОплаты, Истина);
	
	Если ЗначениеЗаполнено(ДокументОбъект.ВидОплаты) Тогда
		ДокументОбъект.Эквайер 				= ДокументОбъект.ВидОплаты.Контрагент;
		ДокументОбъект.ДоговорЭквайринга 	= ДокументОбъект.ВидОплаты.ДоговорКонтрагента;		
		ДокументОбъект.СчетКасса			= ДокументОбъект.ВидОплаты.СчетУчетаРасчетов;
	КонецЕсли;		

	ДокументОбъект.СуммаДокумента	= СтруктураДокумент.СуммаДокумента;
	ДокументОбъект.ДоходыЕНВД_УСН = Истина;
	
	Попытка
		ДокументОбъект.РасшифровкаПлатежа.Очистить();
			
		СтрокаРасшифровка = ДокументОбъект.РасшифровкаПлатежа.добавить();
		СтрокаРасшифровка.ДоговорКонтрагента 			= СтруктураКонтрагент.Договор;

		СтрокаРасшифровка.СуммаПлатежа 					= СтруктураДокумент.СуммаПлатежа;  
		СтрокаРасшифровка.СуммаВзаиморасчетов			= СтруктураДокумент.СуммаПлатежа;
		СтрокаРасшифровка.КурсВзаиморасчетов			= 1;
		СтрокаРасшифровка.СтавкаНДС						= ДокументОбъект.СтавкаНДС;
		
		СтрокаРасшифровка.КратностьВзаиморасчетов 		= 1;
		СтрокаРасшифровка.СпособПогашенияЗадолженности 	= Перечисления.СпособыПогашенияЗадолженности.Автоматически;	
		
		СчетУчета = ПланыСчетов.Хозрасчетный.НайтиПоКоду(СтруктураДокумент.СчетУчетаРаботыСКонтрагентом);		
		СтрокаРасшифровка.СчетУчетаРасчетовСКонтрагентом 	= СчетУчета;
		СтрокаРасшифровка.СчетУчетаРасчетовПоАвансам 		= СчетУчета;
		
	Исключение
	    Возврат Новый Структура("Статус, Сообщение", "Ложь", "Ошибка при заполнении расшифровки платежа 1");
	КонецПопытки;	
	
	Попытка
		
		СчетКомиссия = ПланыСчетов.Хозрасчетный.НайтиПоКоду("91.01");
		
		Если СтруктураДокумент.КомиссияДокумента > 0 тогда
			
			СтрокаРасшифровка = ДокументОбъект.РасшифровкаПлатежа.Добавить();
			
			СтрокаРасшифровка.ДоговорКонтрагента 	= СтруктураКонтрагент.Договор;
						
			СтрокаРасшифровка.СуммаПлатежа		= СтруктураДокумент.КомиссияДокумента;			
			СтрокаРасшифровка.СуммаВзаиморасчетов	= СтруктураДокумент.КомиссияДокумента;
			СтрокаРасшифровка.КурсВзаиморасчетов	= 1;
			СтрокаРасшифровка.СтавкаНДС= ДокументОбъект.СтавкаНДС;
			
			СтрокаРасшифровка.КратностьВзаиморасчетов = 1;
			СтрокаРасшифровка.СчетУчетаРасчетовСКонтрагентом	= СчетКомиссия;
			СтрокаРасшифровка.СчетУчетаРасчетовПоАвансам		= СчетКомиссия;
			СтрокаРасшифровка.СпособПогашенияЗадолженности = Перечисления.СпособыПогашенияЗадолженности.Автоматически;
			
		КонецЕсли;

	Исключение
	    Возврат Новый Структура("Статус, Сообщение", "Ложь", "Ошибка при заполнении расшифровки платежа 2");
	КонецПопытки;	
			
	Попытка 
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Результат.Вставить("Статус", "Истина");
	Исключение    
		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	    Результат.Вставить("Статус", "Ложь");
		Результат.Вставить("ОписаниеОшибки", ОписаниеОшибки());
	КонецПопытки;	
	
	Если ЗначениеЗаполнено(ДокументОбъект.Ссылка) Тогда
		
		Результат.Вставить("ДокументСсылка", Строка(ДокументСсылка));
		МЗ = РегистрыСведений.ДополнительныеСведения.СоздатьМенеджерЗаписи();
		МЗ.Объект = ДокументОбъект.Ссылка;
		МЗ.Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Транзакция", Истина);
		МЗ.Значение = СтруктураДокумент.Транзакция;
		МЗ.Записать(Истина);
		
		Результат.Вставить("ТранзакцияЗаписана", "Истина");
	Иначе
		Результат.Вставить("Сообщение", "Не удалось создать документ");
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

Функция ЗаполнитьДокументЭквайринга(ДокументОбъект, СтруктураДокумент, ТаблицаКонтрагентов)

	//Шихалиев Т.Р. 21.05.2026++
	КодВодителя = "";
	Если СтруктураДокумент.Свойство("КодВодителя") Тогда
		КодВодителя = СтруктураДокумент.КодВодителя;
	КонецЕсли;
	СтруктураКонтрагент = НовыйПоискКонтрагентовИДоговоров(СтруктураДокумент.ВодительНаименование, КодВодителя, ТаблицаКонтрагентов);
	//Шихалиев Т.Р. 21.05.2026--
	Если НЕ ЗначениеЗаполнено(СтруктураКонтрагент.Контрагент) Тогда
		Возврат Новый Структура("Статус, ОписаниеОшибки", "Ложь", "Не заполнен контрагент. Документ не создан!");
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(СтруктураКонтрагент.Договор) Тогда
		Возврат Новый Структура("Статус, ОписаниеОшибки", "Ложь", "Не заполнен договор. Документ не создан!");
	КонецЕсли;
	
	Если НЕ СтруктураДокумент.Свойство("ТранзакцияТакси") Тогда
		Возврат Новый Структура("Статус, ОписаниеОшибки", "Ложь", "Не передана Транзакция. Документ не создан!");
	КонецЕсли;	
		
	РезультатЗаполнения = Новый Структура();
	
	ДокументОбъект.ВидОперации		= Перечисления.ВидыОперацийОплатаПлатежнойКартой.ОплатаПокупателя;
	ДокументОбъект.ВалютаДокумента	= Константы.ВалютаРегламентированногоУчета.Получить();
	ТекущаяОрганизация = Справочники.Организации.Выбрать();
	ТекущаяОрганизация.Следующий();
		
	ДокументОбъект.Контрагент 		= СтруктураКонтрагент.Контрагент;
	ДокументОбъект.Организация		= ТекущаяОрганизация.Ссылка;
	ДокументОбъект.Комментарий		= "Перенос из такси новый";
	ДокументОбъект.СтавкаНДС		= Перечисления.СтавкиНДС.БезНДС;
	
	ДокументОбъект.ВидОплаты = Справочники.ВидыОплатОрганизаций.НайтиПоНаименованию(СтруктураДокумент.ВидОплаты, Истина);
	
	Если ЗначениеЗаполнено(ДокументОбъект.ВидОплаты) Тогда
		ДокументОбъект.Эквайер 				= ДокументОбъект.ВидОплаты.Контрагент;
		ДокументОбъект.ДоговорЭквайринга 	= ДокументОбъект.ВидОплаты.ДоговорКонтрагента;		
		ДокументОбъект.СчетКасса			= ДокументОбъект.ВидОплаты.СчетУчетаРасчетов;
	КонецЕсли;		

	ДокументОбъект.СуммаДокумента	= СтруктураДокумент.СуммаДокумента;
	ДокументОбъект.ДоходыЕНВД_УСН = Истина;
	
	Попытка
		ДокументОбъект.РасшифровкаПлатежа.Очистить();
			
		СтрокаРасшифровка = ДокументОбъект.РасшифровкаПлатежа.добавить();
		СтрокаРасшифровка.ДоговорКонтрагента 			= СтруктураКонтрагент.Договор;

		СтрокаРасшифровка.СуммаПлатежа 					= СтруктураДокумент.СуммаПлатежа;  
		СтрокаРасшифровка.СуммаВзаиморасчетов			= СтруктураДокумент.СуммаПлатежа;
		СтрокаРасшифровка.КурсВзаиморасчетов			= 1;
		СтрокаРасшифровка.СтавкаНДС						= ДокументОбъект.СтавкаНДС;
		
		СтрокаРасшифровка.КратностьВзаиморасчетов 		= 1;
		СтрокаРасшифровка.СпособПогашенияЗадолженности 	= Перечисления.СпособыПогашенияЗадолженности.Автоматически;	
		
		СчетУчета = ПланыСчетов.Хозрасчетный.НайтиПоКоду(СтруктураДокумент.СчетУчетаРаботыСКонтрагентом);		
		СтрокаРасшифровка.СчетУчетаРасчетовСКонтрагентом 	= СчетУчета;
		СтрокаРасшифровка.СчетУчетаРасчетовПоАвансам 		= СчетУчета;
		
	Исключение
	    Возврат Новый Структура("Статус, ОписаниеОшибки", "Ложь", "Ошибка при заполнении расшифровки платежа 1");
	КонецПопытки;	
	
	Попытка
		
		СчетКомиссия = ПланыСчетов.Хозрасчетный.НайтиПоКоду("91.01");
		
		Если СтруктураДокумент.КомиссияДокумента > 0 тогда
			
			СтрокаРасшифровка = ДокументОбъект.РасшифровкаПлатежа.Добавить();
			
			СтрокаРасшифровка.ДоговорКонтрагента 	= СтруктураКонтрагент.Договор;
						
			СтрокаРасшифровка.СуммаПлатежа		= СтруктураДокумент.КомиссияДокумента;			
			СтрокаРасшифровка.СуммаВзаиморасчетов	= СтруктураДокумент.КомиссияДокумента;
			СтрокаРасшифровка.КурсВзаиморасчетов	= 1;
			СтрокаРасшифровка.СтавкаНДС= ДокументОбъект.СтавкаНДС;
			
			СтрокаРасшифровка.КратностьВзаиморасчетов = 1;
			СтрокаРасшифровка.СчетУчетаРасчетовСКонтрагентом	= СчетКомиссия;
			СтрокаРасшифровка.СчетУчетаРасчетовПоАвансам		= СчетКомиссия;
			СтрокаРасшифровка.СпособПогашенияЗадолженности = Перечисления.СпособыПогашенияЗадолженности.Автоматически;
			
		КонецЕсли;

	Исключение
	    Возврат Новый Структура("Статус, ОписаниеОшибки", "Ложь", "Ошибка при заполнении расшифровки платежа 2");
	КонецПопытки;	
			
	Попытка 
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		РезультатЗаполнения.Вставить("Статус", "Истина");
	Исключение    
		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	    РезультатЗаполнения.Вставить("Статус", "Ложь");
		РезультатЗаполнения.Вставить("ОписаниеОшибки", ОписаниеОшибки());
	КонецПопытки;	
	
	Если ЗначениеЗаполнено(ДокументОбъект.Ссылка) Тогда
		
		РезультатЗаполнения.Вставить("ДокументСсылка", Строка(ДокументОбъект.Ссылка));
		МЗ = РегистрыСведений.ДополнительныеСведения.СоздатьМенеджерЗаписи();
		МЗ.Объект = ДокументОбъект.Ссылка;
		МЗ.Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Транзакция", Истина);
		МЗ.Значение = СтруктураДокумент.ТранзакцияТакси;
		МЗ.Записать(Истина);
		
		РезультатЗаполнения.Вставить("ТранзакцияЗаписана", "Истина");
	Иначе   
		РезультатЗаполнения.Вставить("Статус", "Ложь");
		РезультатЗаполнения.Вставить("ОписаниеОшибки", "Не удалось создать документ");
	КонецЕсли;	
	
	Возврат РезультатЗаполнения;
	
КонецФункции

//Шихалиев Т.Р. 02.07.2026 НЕ ИСПОЛЬЗУЕТСЯ (мёртвый код): пометка на удаление выполняется инлайн в ВыполнитьОперациюСДокументом.
Функция УдалитьДокументЭквайринга(СтруктураДокумент)
	
	Результат = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(СтруктураДокумент);
	
	ДатаДокумента = ДатаИзСтроки(СтруктураДокумент.ДатаДокумента);
	
	Если НЕ ТипЗнч(ДатаДокумента) = Тип("Дата") Тогда
		Возврат Новый Структура("Статус, Сообщение", "Ложь", "Не удалось распознать дату документа!");
	ИначеЕсли Год(ДатаДокумента) < 2020 Тогда
		Возврат Новый Структура("Статус, Сообщение, ДатаДок", "Ложь", "Некорректная дата документа!", Строка(ДатаДокумента));
	КонецЕсли;
	
	Попытка
		ДокументСсылка = ПоискДокументаЭквайринга(СтруктураДокумент, ДатаДокумента);
	Исключение
	    Возврат Новый Структура("Статус, Сообщение", "Ложь", "Ошибка при поиске документа");
	КонецПопытки;
		
	Если ЗначениеЗаполнено(ДокументСсылка) Тогда
		ДокументОбъект = ДокументСсылка.ПолучитьОбъект(); 
		ДокументОбъект.УстановитьПометкуУдаления(Истина);
		Результат.Вставить("Статус", "Истина");
	Иначе
		Результат.Вставить("Статус", "Ложь");
		Результат.Вставить("Сообщение", "Не удалось получить документ");
		Результат.Вставить("ДатаДок", Строка(ДатаДокумента));
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

//этот код повторяется для каждого типа документа, мне уже надоело его копировать постоянно
//еще есть желание унифицировать создание документа и представление результатов
Функция ВыполнитьОперациюСДокументом(СтруктураДокумент, ТаблицаКонтрагентов)
	
	Если НЕ СтруктураДокумент.Свойство("Операция") Тогда
		Возврат Новый Структура("Статус, ОписаниеОшибки", "Ложь", "Не указана операция!");
	ИначеЕсли НЕ СтруктураДокумент.Свойство("ТипДокумента") Тогда 
		Возврат Новый Структура("Статус, ОписаниеОшибки", "Ложь", "Не указантип документа!");
	КонецЕсли;
	
    Результат = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(СтруктураДокумент);
	
	ДатаДокумента = ДатаИзСтроки(СтруктураДокумент.ДатаДокумента);
	
	Если НЕ ТипЗнч(ДатаДокумента) = Тип("Дата") Тогда
		Возврат Новый Структура("Статус, ОписаниеОшибки", "Ложь", "Не удалось распознать дату документа!");
	ИначеЕсли Год(ДатаДокумента) < 2020 Тогда
		Возврат Новый Структура("Статус, ОписаниеОшибки, ДатаДок", "Ложь", "Некорректная дата документа!", Строка(ДатаДокумента));
	КонецЕсли;

	СтруктураПоиска = Новый Структура("ДатаДокумента", ДатаДокумента);
	Если СтруктураДокумент.ТипДокумента = "ОплатаПлатежнойКартой" Тогда		
		СтруктураПоиска.Вставить("Контрагент", 		СтруктураДокумент.ВодительНаименование);
		СтруктураПоиска.Вставить("СуммаПлатежа", 	СтруктураДокумент.СуммаПлатежа);
		ДокументСсылка = ПоискДокументаЭквайринга(СтруктураДокумент, ДатаДокумента, ТаблицаКонтрагентов);
	Иначе
		//тут будут другие типы документов
	КонецЕсли;

	Результат.Вставить("НайденныйДокумент", Строка(ДокументСсылка));
	
	Если СтруктураДокумент.Операция = "УдалениеДокумента"
		И НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Результат.Вставить("ОписаниеОшибки", "Удаляемый документ не найден");
		Возврат Результат;
	КонецЕсли;
		
	Если ЗначениеЗаполнено(ДокументСсылка) Тогда
		ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
	ИначеЕсли СтруктураДокумент.Операция = "СозданиеДокумента" Тогда
		ДокументОбъект = Документы[СтруктураДокумент.ТипДокумента].СоздатьДокумент();		
	КонецЕсли;
	
	Если СтруктураДокумент.Операция = "СозданиеДокумента" Тогда
		//сразу заполним дату, чтобы не передавать ее дальше
		ДокументОбъект.Дата = ДатаДокумента; 
		Если СтруктураДокумент.ТипДокумента = "ОплатаПлатежнойКартой" Тогда
			РезультатЗаполнения = ЗаполнитьДокументЭквайринга(ДокументОбъект, СтруктураДокумент, ТаблицаКонтрагентов);
		Иначе
			//тут будут другие типы документов
		КонецЕсли;
		Если ТипЗнч(РезультатЗаполнения) = Тип("Структура") Тогда
			СкопироватьСвойстваСтруктуры(Результат, РезультатЗаполнения);
		КонецЕсли;
	Иначе	
		ДокументОбъект.УстановитьПометкуУдаления(Истина);
		
		//Шихалиев Т.Р. 02.07.2026++ была инверсия: ошибка выдавалась при успешной установке пометки.
		// Старое: Если ДокументОбъект.ПометкаУдаления Тогда
		Если НЕ ДокументОбъект.ПометкаУдаления Тогда
		//Шихалиев Т.Р. 02.07.2026--
			Результат.Вставить("Статус", "Ложь");
			Результат.Вставить("ОписаниеОшибки", "Почему то не получилось пометить на удаление");
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОбработатьДокументыЭквайринга(СтруктураПараметров)
	
	Если НЕ СтруктураПараметров.Свойство("МассивДокументов") Тогда
		СтруктураОтвета = Новый Структура();
		СтруктураОтвета.Вставить("ТестовыйПараметр", "ДокументыЭквайринг2");
		Возврат СтруктураОтвета;
	КонецЕсли;
	
	СтруктураПоискаКонтрагентов = ОбработатьКонтрагентовИДоговоры(СтруктураПараметров);			
	ТаблицаКонтрагентов = СтруктураПоискаКонтрагентов.ТаблицаКонтрагентов;
	
	СтруктураОтвета = Новый Структура();
	СтруктураОтвета.Вставить("МассивКонтрагентов", 				ПреобразоватьТаблицуВМассивСтрокДляВыгрузки(ТаблицаКонтрагентов, Истина));
	СтруктураОтвета.Вставить("РезультатПоискаКонтрагентов", 	СтруктураПоискаКонтрагентов.РезультатПоиска);		
	
	РезультатСоздания = Новый Структура();
	МассивОтветов = Новый Массив;
	Для каждого ЭлементМассива из СтруктураПараметров.МассивДокументов Цикл
					
		СтруктураДокумента = ВыполнитьОперациюСДокументом(ЭлементМассива, ТаблицаКонтрагентов);
		МассивОтветов.Добавить(СтруктураДокумента);
		
	КонецЦикла;
		
	РезультатСоздания.Вставить("МассивОтветов", МассивОтветов);
	СтруктураОтвета.Вставить("РезультатСоздания", РезультатСоздания);
			
	Возврат СтруктураОтвета;
	
КонецФункции
