Функция	ПолучитьПараметрыПоступленийОтСтраховых(СтруктураПараметров)	
	
	Попытка
		//ДатаНачала 		= ДатаИзСтроки(СтруктураПараметров.ДатаНачала);
		//ДатаОкончания 	= ДатаИзСтроки(СтруктураПараметров.ДатаОкончания);
		//Организация 	= Справочники.Организации.НайтиПоРеквизиту("ИНН", СтруктураПараметров.ИННОрганизации);
		
		ДанныеТакси = ПреобразоватьТаблицуИзМассиваСтрок(СтруктураПараметров, "МассивДокументов");
						
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ДанныеТакси.УИДУщерба КАК УИДУщерба,
			|	ДанныеТакси.НомерУбыткаСК КАК НомерУбыткаСК
			|ПОМЕСТИТЬ ВТ_ДанныеТакси
			|ИЗ
			|	&ДанныеТакси КАК ДанныеТакси
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	МАКСИМУМ(ПоступлениеНаРасчетныйСчет.Дата) КАК Дата,
			|	СУММА(ПоступлениеНаРасчетныйСчет.СуммаДокумента) КАК СуммаПоступленияНаРС,
			|	ВТ_ДанныеТакси.УИДУщерба КАК УИДУщерба,
			|	ВТ_ДанныеТакси.НомерУбыткаСК КАК НомерУбыткаСК
			|ИЗ
			|	ВТ_ДанныеТакси КАК ВТ_ДанныеТакси
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеНаРасчетныйСчет КАК ПоступлениеНаРасчетныйСчет
			|		ПО (ПоступлениеНаРасчетныйСчет.НазначениеПлатежа ПОДОБНО ""%"" + ВТ_ДанныеТакси.НомерУбыткаСК + ""%"")
			|			И (НЕ ВТ_ДанныеТакси.НомерУбыткаСК = """")
			|ГДЕ
			|	ПоступлениеНаРасчетныйСчет.Проведен
			|
			|СГРУППИРОВАТЬ ПО
			|	ВТ_ДанныеТакси.УИДУщерба,
			|	ВТ_ДанныеТакси.НомерУбыткаСК
			|
			|УПОРЯДОЧИТЬ ПО
			|	Дата УБЫВ";
		
		Запрос.УстановитьПараметр("ДанныеТакси",	ДанныеТакси);
		
		РезультатЗапроса		=	Запрос.Выполнить();	
