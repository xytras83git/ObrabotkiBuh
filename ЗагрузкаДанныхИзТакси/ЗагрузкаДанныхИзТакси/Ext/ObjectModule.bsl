Функция ПодключитьПрофильПользователю(СтруктураПараметров)
	
	ИдентификаторПользователяИБ = БезопасноеПолучениеСвойстваСтруктуры(СтруктураПараметров, "ИдентификаторПользователяИБ", "0000");
	Если СтрНайти(ИдентификаторПользователяИБ, "000") > 0 Тогда	
		Возврат ПолучитьРезультатСОшибкой("Некорректный УИД пользователя");
	КонецЕсли;
	
	УИД = Новый УникальныйИдентификатор(СтруктураПараметров.ИдентификаторПользователяИБ);	
	ПользовательСсылка = Пользователи.НайтиПоИдентификатору(УИД);
	
	ПрофильСсылка = Справочники.ПрофилиГруппДоступа.НайтиПоНаименованию(СтруктураПараметров.ИмяПрофиля, Истина);
	
	Если НЕ ЗначениеЗаполнено(ПользовательСсылка) Тогда
		Возврат ПолучитьРезультатСОшибкой("Не найден пользователь в базе");
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(ПрофильСсылка) Тогда
		Возврат ПолучитьРезультатСОшибкой("Не найден профиль по наименованию");
	КонецЕсли;
	
	ДействиеСПрофилем = БезопасноеПолучениеСвойстваСтруктуры(СтруктураПараметров, "Действие", "Неопределено"); 
	
	Если ДействиеСПрофилем = "Неопределено" Тогда
		Возврат ПолучитьРезультатСОшибкой("Не передан служебный параметр Действие");
	КонецЕсли;
	
	Если ДействиеСПрофилем = "Включить" Тогда
		УправлениеДоступом.ВключитьПрофильПользователю(ПользовательСсылка, ПрофильСсылка);
	ИначеЕсли ДействиеСПрофилем = "Выключить" Тогда
		УправлениеДоступом.ВыключитьПрофильПользователю(ПользовательСсылка, ПрофильСсылка);
	КонецЕсли;
	
	Возврат Новый Структура("Ошибка", Ложь);
	
