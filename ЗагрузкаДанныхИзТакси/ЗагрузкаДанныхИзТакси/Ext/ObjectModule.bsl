 Функция ПолучитьМассивОСГОП(СтруктураОтбора)
	Попытка
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПоступлениеТоваровУслуг.Номер КАК Номер,
		|	ПоступлениеТоваровУслуг.Дата КАК Дата,
		|	ПоступлениеТоваровУслугУслуги.Сумма КАК Сумма,
		|	ПоступлениеТоваровУслуг.Контрагент КАК Контрагент,
		|	ПоступлениеТоваровУслуг.Ссылка КАК Ссылка,
		|	ПоступлениеТоваровУслуг.Комментарий КАК Госномер,
		|	ДоговорыКонтрагентов.Наименование КАК ДоговорНаименование
		|ПОМЕСТИТЬ ВТ_МассивДокументов
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг.Услуги КАК ПоступлениеТоваровУслугУслуги
		|		ПО ПоступлениеТоваровУслуг.Ссылка = ПоступлениеТоваровУслугУслуги.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|		ПО ПоступлениеТоваровУслуг.ДоговорКонтрагента = ДоговорыКонтрагентов.Ссылка
		|ГДЕ
		|	ПоступлениеТоваровУслуг.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&ДатаНачала, МЕСЯЦ) И ДОБАВИТЬКДАТЕ(КОНЕЦПЕРИОДА(&ДатаОкончания, МЕСЯЦ), МЕСЯЦ, 1)
		|	И ПоступлениеТоваровУслугУслуги.Номенклатура.Наименование = ""ОСГОП""
		|	И ПоступлениеТоваровУслуг.Проведен = ИСТИНА
		|	И ПоступлениеТоваровУслуг.Организация = &Организация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_МассивДокументов.Госномер КАК Госномер
		|ИЗ
		|	ВТ_МассивДокументов КАК ВТ_МассивДокументов";

	
	Запрос.УстановитьПараметр("Организация", 	СтруктураОтбора.Организация);
	Запрос.УстановитьПараметр("ДатаНачала", 	СтруктураОтбора.ДатаНачала); 
	Запрос.УстановитьПараметр("ДатаОкончания", 	КонецДня(СтруктураОтбора.ДатаОкончания));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТаблицаЗадвоений = РезультатЗапроса.Выгрузить();
	ТаблицаДокументов = ПолучитьВТ(Запрос.МенеджерВременныхТаблиц, "ВТ_МассивДокументов");
	МассивДокументов = ПреобразоватьТаблицуВМассивСтрокДляВыгрузки(ТаблицаДокументов, Истина);
	
	Результат = Новый Структура("МассивДокументов", МассивДокументов); 
	Результат.Вставить("МассивДокументовКоличество", МассивДокументов.Количество());
	Если ТаблицаЗадвоений.Количество() > 0 Тогда
		Результат.Вставить("МассивЗадвоений", ТаблицаЗадвоений.ВыгрузитьКолонку("Госномер"));
	КонецЕсли;
Исключение  
	Возврат Новый Структура("ОписаниеОшибки", ОписаниеОшибки());
	КонецПопытки;
	
	Возврат Результат;	
	
КонецФункции

 Функция ПолучитьДокументыОСГОПЗаПериод(СтруктураПараметров)
	
	Если СтруктураПараметров.Свойство("ДатаНачала") Тогда
			
		ДатаНачала 		= ДатаИзСтроки(СтруктураПараметров.ДатаНачала);
		ДатаОкончания 	= ДатаИзСтроки(СтруктураПараметров.ДатаОкончания);
		Организация = Справочники.Организации.НайтиПоРеквизиту("ИНН", СтруктураПараметров.ИННОрганизации);
		СтруктураОтбора = Новый Структура("ДатаНачала, ДатаОкончания, Организация,Госномер", ДатаНачала, ДатаОкончания, Организация);
				
		СтруктураДокументов = ПолучитьМассивОСГОП(СтруктураОтбора);
		Если СтруктураДокументов.Свойство("ОписаниеОшибки") Тогда
			Возврат СтруктураДокументов;
		КонецЕсли;
		СтруктураОтвета = Новый Структура();
		СтруктураОтвета.Вставить("Статус", 					"Истина");
		СтруктураОтвета.Вставить("ДатаЗапретаИзменения", 	Строка(ПолучитьДатуЗапретаИзменения()));
		СтруктураОтвета.Вставить("Отладка", 				"Истина");
		СтруктураОтвета.Вставить("МассивОСГОП", 			СтруктураДокументов.МассивДокументов);
		Если СтруктураДокументов.Свойство("МассивЗадвоений") Тогда
			СтруктураОтвета.Вставить("МассивЗадвоений", 	СтруктураДокументов.МассивЗадвоений);
		КонецЕсли;
			
		Возврат СтруктураОтвета;
		
	КонецЕсли;
	
	СтруктураОтвета = Новый Структура();
	СтруктураОтвета.Вставить("ТестовыйПараметр", "ДокументыЭквайринг2");
		
	Возврат СтруктураОтвета;
	
КонецФункции

 Функция СоздатьДокументыОСГОП(СтруктураПараметров)
	
	Если СтруктураПараметров.Свойство("МассивДокументов") Тогда
		
		СтруктураОтвета = Новый Структура();
		
		РезультатСоздания = Новый Структура();
		МассивОтветов = Новый Массив;
	//	Возврат СтруктураПараметров;
		Для каждого СтрокаДокумент из СтруктураПараметров.МассивДокументов Цикл 
			СтрокаДокумент.Вставить("ОрганизацияИННК", СтруктураПараметров.ИННОрганизации);
			СтруктураДокумента = СоздатьДокументОСГОП(СтрокаДокумент);
			ДополнитьРезультатЛогированияОперации(СтруктураДокумента, "ОСГОП");
			МассивОтветов.Добавить(СтруктураДокумента);
		КонецЦикла;
		РезультатСоздания.Вставить("МассивОтветов", 	МассивОтветов);//надо так, ниже в отладочных целях
		//РезультатСоздания.Вставить("МассивОтветов222", 	СтруктураПараметров.МассивДокументов);
		СтруктураОтвета.Вставить("РезультатСоздания", РезультатСоздания);
	Иначе
		СтруктураОтвета = Новый Структура();
		СтруктураОтвета.Вставить("ТестовыйПараметр", "ДокументыЭквайринг2");
	КонецЕсли;
	
	Возврат СтруктураОтвета;	
	
	
КонецФункции

 Функция ПоискДокументаОСГОП(ДатаДокумента, Госномер)
	
	Результат = Новый Структура();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПоступлениеТоваровУслуг.Номер КАК Номер,
		|	ПоступлениеТоваровУслуг.Дата КАК Дата,
		|	ПоступлениеТоваровУслугУслуги.Сумма КАК Сумма,
		|	ПоступлениеТоваровУслуг.Контрагент КАК Контрагент,
		|	ПоступлениеТоваровУслуг.Ссылка КАК Ссылка,
		|	ПоступлениеТоваровУслуг.Комментарий КАК Госномер
		|ПОМЕСТИТЬ ВТ_ДокументыЗаПериод
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг.Услуги КАК ПоступлениеТоваровУслугУслуги
		|		ПО ПоступлениеТоваровУслуг.Ссылка = ПоступлениеТоваровУслугУслуги.Ссылка
		|ГДЕ
		|	ПоступлениеТоваровУслуг.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&ДатаНачала, ДЕНЬ) И КОНЕЦПЕРИОДА(&ДатаОкончания, ДЕНЬ)
		|	И ПоступлениеТоваровУслугУслуги.Номенклатура.Наименование = ""ОСГОП""
		|	И ПоступлениеТоваровУслуг.Комментарий ПОДОБНО ""%"" + &Госномер + ""%""
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ДокументыЗаПериод.Номер КАК Номер,
		|	ВТ_ДокументыЗаПериод.Дата КАК Дата,
		|	ВТ_ДокументыЗаПериод.Сумма КАК Сумма,
		|	ВТ_ДокументыЗаПериод.Контрагент КАК Контрагент,
		|	ВТ_ДокументыЗаПериод.Ссылка КАК Ссылка,
		|	ВТ_ДокументыЗаПериод.Госномер КАК Госномер
		|ИЗ
		|	ВТ_ДокументыЗаПериод КАК ВТ_ДокументыЗаПериод";
	
	Запрос.УстановитьПараметр("Госномер", 		Госномер);
	Запрос.УстановитьПараметр("ДатаНачала", 	НачалоДня(ДатаДокумента));
	Запрос.УстановитьПараметр("ДатаОкончания", 	КонецДня(ДатаДокумента));
	Результат.Вставить("Статус", "Доши до выполнения запроса");
	Результат.Вставить("Документ", Документы.ПоступлениеТоваровУслуг.ПустаяСсылка());
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат.Вставить("Документ", Выборка.Ссылка);
		Результат.Вставить("Статус", "Документ найден");
	ИначеЕсли РезультатЗапроса.Выгрузить().Количество() > 1 Тогда
		Результат.Вставить("Статус", "Ошибка при поиске");
		Результат.Вставить("Документ", Документы.ПоступлениеТоваровУслуг.ПустаяСсылка());
	Иначе 
		Результат.Вставить("Статус", "Не найден документ");
		Результат.Вставить("Документ", Документы.ПоступлениеТоваровУслуг.ПустаяСсылка());		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

 Функция ПоискРасходовБудущихПериодовОСГОП(СтруктураДокумент)
	
	Результат = Новый Структура();
	
	ДатаНачала 		= ДатаИзСтроки(СтруктураДокумент.ДатаНачала);
	ДатаОкончания 	= ДатаИзСтроки(СтруктураДокумент.ДатаОкончания);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РасходыБудущихПериодов.Ссылка КАК Ссылка,
		|	РасходыБудущихПериодов.Наименование КАК Наименование,
		|	РасходыБудущихПериодов.ДатаНачалаСписания КАК ДатаНачалаСписания,
		|	РасходыБудущихПериодов.ДатаОкончанияСписания КАК ДатаОкончанияСписания,
		|	РасходыБудущихПериодов.Сумма КАК Сумма
		|ИЗ
		|	Справочник.РасходыБудущихПериодов КАК РасходыБудущихПериодов
		|ГДЕ
		|	РасходыБудущихПериодов.Наименование ПОДОБНО ""%"" + &Госномер + ""%""
		|	И НАЧАЛОПЕРИОДА(РасходыБудущихПериодов.ДатаНачалаСписания, ДЕНЬ) = &ДатаНачала";
	
	Запрос.УстановитьПараметр("Госномер", 	СтруктураДокумент.Госномер);
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат.Вставить("Действие", "Найден элемент"); 
		Результат.Вставить("ЭлементСправочника", Выборка.Ссылка);
		
		ЭлементРБПОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ЭлементРБПОбъект.Наименование 				= "ОСГОП " + СтруктураДокумент.Полис + "/" + СтруктураДокумент.Госномер + " с "+Формат(ДатаНачала, "ДФ=dd.MM.yy") + " по "+ Формат(ДатаОкончания, "ДФ=dd.MM.yy");
		ЭлементРБПОбъект.Записать();
		
	Иначе 
		Результат.Вставить("Действие", "Создание элемента");
		ЭлементРБПОбъект = Справочники.РасходыБудущихПериодов.СоздатьЭлемент();
		ЭлементРБПОбъект.Наименование 				= "ОСГОП " + СтруктураДокумент.Полис + "/" + СтруктураДокумент.Госномер + "с "+Формат(ДатаНачала, "ДФ=dd.MM.yy") + " по "+ Формат(ДатаОкончания, "ДФ=dd.MM.yy");
		ЭлементРБПОбъект.ДатаНачалаСписания 		= ДатаНачала;
		ЭлементРБПОбъект.ДатаОкончанияСписания 		= ДатаОкончания;
		ЭлементРБПОбъект.Сумма						= СтруктураДокумент.ЦенаСтраховки;
		ЭлементРБПОбъект.ВидАктива 					= Перечисления.ВидыАктивовДляРБП.ПрочиеОборотныеАктивы;
		ЭлементРБПОбъект.ВидРБП						= Перечисления.ВидыРБП.Прочие;	
		ЭлементРБПОбъект.СпособПризнанияРасходов	= Перечисления.СпособыПризнанияРасходов.ПоМесяцам;
		ЭлементРБПОбъект.СчетЗатрат 				= ПланыСчетов.Хозрасчетный.НайтиПоКоду("26");
		ЭлементРБПОбъект.СубконтоЗатрат1 			= Справочники.СтатьиЗатрат.НайтиПоНаименованию("ОСГОП", Истина);
		
		ЭлементРБПОбъект.Комментарий = "Перенос из такси ОСГОП";
		ЭлементРБПОбъект.Записать(); 
		
		Результат.Вставить("ЭлементСправочника", ЭлементРБПОбъект.Ссылка);

	КонецЕсли;
	
	Возврат Результат
		
КонецФункции

 Функция СоздатьДокументОСГОП(СтруктураДокумент)
		
	//Результат = Новый Структура();
	Результат = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(СтруктураДокумент);
	//Возврат СтруктураДокумент;
	//управляем датой на стороне Такси!
	//Возврат Новый Структура("ДатаДокумента", СтруктураДокумент.ДатаДокумента);
	ДатаДокумента = ДатаИзСтроки(СтруктураДокумент.ДатаДокумента);


	
		
	Если НЕ ТипЗнч(ДатаДокумента) = Тип("Дата") Тогда
		Возврат Новый Структура("Статус, Сообщение", "Ложь", "Не удалось распознать дату документа!");
	ИначеЕсли Год(ДатаДокумента) < 2020 Тогда
		Возврат Новый Структура("Статус, Сообщение", "Ложь", "Некорректная дата документа!");
	ИначеЕсли НЕ ЗначениеЗаполнено(СтруктураДокумент.СтраховщикИНН) Тогда
		Возврат Новый Структура("Статус, Сообщение", "Ложь", "Не указан ИНН страховщика!");
	КонецЕсли;
	//Возврат Новый Структура("ДатаДокумента", ДатаДокумента);
	
	ПоискДокумента = ПоискДокументаОСГОП(ДатаДокумента,СтруктураДокумент.Госномер);   
	//Возврат Новый Структура("ДатаДокумента", ДатаДокумента);
	//Возврат ПоискДокумента;
	Если ПоискДокумента.Статус = "Документ найден" Тогда 
		ДокументСсылка = ПоискДокумента.Документ;
		ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
		ДокументБылНайден = Истина;
	Иначе
		
		Результат.Вставить("Статус", ПоискДокумента.Статус);
		
		ДокументОбъект = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент();
		
		ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийПоступлениеТоваровУслуг.Услуги;
		ДокументОбъект.Дата 			= ДатаДокумента;
		Результат.Вставить("ВидОперации", Строка(ДокументОбъект.ВидОперации));
		Результат.Вставить("Дата", ТекущаяДата());
		Результат.Вставить("Номер", ДокументОбъект.Номер);  
		//Возврат СтруктураДокумент;
		ДокументОбъект.Организация		= Справочники.Организации.НайтиПоРеквизиту("ИНН", СтруктураДокумент.ОрганизацияИННК);
		ДокументБылНайден = Ложь;
	КонецЕсли;
	
	НомерПолиса = СтрЗаменить(СтруктураДокумент.Полис, " ", "");
	
	Если Лев(НомерПолиса, 4) <> "GRSX" Тогда
		НомерПолиса = "GRSX" + НомерПолиса;
	КонецЕсли;
	
	ДокументОбъект.НомерВходящегоДокумента = НомерПолиса;
	ДокументОбъект.ДатаВходящегоДокумента = ДатаДокумента;
	
	ДокументОбъект.ВалютаДокумента		= Константы.ВалютаРегламентированногоУчета.Получить();
	ДокументОбъект.Контрагент 			= Справочники.Контрагенты.НайтиПоРеквизиту("ИНН", СтруктураДокумент.СтраховщикИНН);
	//для Драйва отдельная ветка
	//Если ДатаДокумента > Дата("20230501") Тогда 
		ДатаНачала 		= ДатаИзСтроки(СтруктураДокумент.ДатаНачала);
		НомерПолиса = СтрЗаменить(СтруктураДокумент.Полис, " ", "");
		НомерПолиса = СтрЗаменить(НомерПолиса, "GRSX", "");
		НаименованиеДоговора = "Полис GRSX" + НомерПолиса + "/" + СтруктураДокумент.Госномер
	+ " от " + Формат(ДатаНачала, "ДФ=dd.MM.yyyy"); 
		ПоискДоговора = СоздатьСправочникДоговоров(ДокументОбъект.Контрагент, ДокументОбъект.Организация, НаименованиеДоговора, Истина);
		ДокументОбъект.ДоговорКонтрагента	= ПоискДоговора.Договор;
		
		Результат.Вставить("НовыйДоговор", 			НаименованиеДоговора);
		Результат.Вставить("ДоговорНайденный", 		Строка(ДокументОбъект.ДоговорКонтрагента));
		Результат.Вставить("ДоговорНайден", 		Строка(ПоискДоговора.Найден));
		Результат.Вставить("НаименованиеСоздания", 	Строка(ПоискДоговора.НаименованиеСоздания)); 
		Результат.Вставить("НаименованиеНовогоДоговора", 	Строка(ПоискДоговора.НаименованиеНовогоДоговора)); 		
		
	//Иначе
	//	Если СтруктураДокумент.ИннСобственник = "7724351790" Тогда
	//		ПоискДоговора = СоздатьСправочникДоговоров(ДокументОбъект.Контрагент, ДокументОбъект.Организация, "Без договора", Истина);
	//		ДокументОбъект.ДоговорКонтрагента	= ПоискДоговора.Договор;
	//	Иначе
	//		ПоискДоговора = СоздатьСправочникДоговоров(ДокументОбъект.Контрагент, ДокументОбъект.Организация, "Основной договор", Истина);
	//		ДокументОбъект.ДоговорКонтрагента	= ПоискДоговора.Договор;
	//	КонецЕсли;
	//КонецЕсли;
    ДокументОбъект.Комментарий = СтруктураДокумент.Госномер;
	
	ДокументОбъект.НДСВключенВСтоимость = Истина;
	
	ДокументОбъект.СпособЗачетаАвансов  			= Перечисления.СпособыЗачетаАвансов.Автоматически;
	ДокументОбъект.СчетУчетаРасчетовСКонтрагентом 	= ПланыСчетов.Хозрасчетный.НайтиПоКоду("60.01");
	ДокументОбъект.СчетУчетаРасчетовПоАвансам 		= ПланыСчетов.Хозрасчетный.НайтиПоКоду("60.02");
	
	ДокументОбъект.Услуги.Очистить();
	
	НоваяСтрока = ДокументОбъект.Услуги.Добавить();
	НоваяСтрока.Номенклатура 	= Справочники.Номенклатура.НайтиПоНаименованию("ОСГОП", Истина);
	НоваяСтрока.Содержание = "Соглашение к полису GRSX" + НомерПолиса;
	НоваяСтрока.Количество		= 1;
	НоваяСтрока.Цена			= СтруктураДокумент.ЦенаСтраховки;
	НоваяСтрока.Сумма			= СтруктураДокумент.ЦенаСтраховки;
	НоваяСтрока.СтавкаНДС		= Перечисления.СтавкиНДС.БезНДС;
	НоваяСтрока.ОтражениеВУСН	= Перечисления.ОтражениеВУСН.Принимаются;
	НоваяСтрока.СчетЗатрат		= ПланыСчетов.Хозрасчетный.НайтиПоКоду("97.21");
	
	СтруктураРБП = ПоискРасходовБудущихПериодовОСГОП(СтруктураДокумент);
	НоваяСтрока.Субконто1		= СтруктураРБП.ЭлементСправочника;
	
	//Если УчетнаяПолитика.СистемаНалогообложения(ДокументОбъект.Организация, ДатаДокумента) = Перечисления.СистемыНалогообложения.Общая Тогда
		НоваяСтрока.СчетЗатратНУ	= ПланыСчетов.Хозрасчетный.НайтиПоКоду("97.21");
		НоваяСтрока.СубконтоНУ1		= СтруктураРБП.ЭлементСправочника;
	//КонецЕсли;

	//Попытка
	//	ДокументОбъект.Записать(РежимЗаписиДокумента.Запись); 
	//	Результат.Вставить("Статус", 			"Истина");
	//	Результат.Вставить("ДокументПроведен", 	"Ложь");
	//	//Возврат Новый Структура("Ссылка", ДокументОбъект.Ссылка);//скорее всего, был для отладочных целей
	//Исключение
	//	Результат.Вставить("ОписаниеОшибки", 	Строка(ОписаниеОшибки()));
	//	Результат.Вставить("Статус", 			"Ложь");
	//	Возврат Результат;
	//КонецПопытки;
	//
	Попытка
		
		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		Результат.Вставить("Статус", 			"Истина");
		Результат.Вставить("ДокументПроведен", 	"Ложь");	
		
	Исключение                              
		Результат.Вставить("Статус", 	"Ложь");
		//Результат.Вставить("Сообщение", 				Строка(ОписаниеОшибки()));	
		Результат.Вставить("ОписаниеОшибки", 			Строка(ОписаниеОшибки()));	
		Результат.Вставить("НеУдалосьЗаписатьПроводки", "Истина");	
	КонецПопытки;
	
	ДополнитьРезультатЛогированияДокумента(Результат, ДокументОбъект, "ОСГОП", ДокументБылНайден);
	Возврат Результат;	
	
КонецФункции

