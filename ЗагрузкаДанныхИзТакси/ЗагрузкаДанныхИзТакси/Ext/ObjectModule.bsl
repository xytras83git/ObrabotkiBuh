Процедура СоздатьСчетФактуру()
	
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ Первые 1
	               |	ОказаниеУслуг.Ссылка КАК Ссылка,
	               |	ОказаниеУслуг.Дата КАК Дата,
				   |	ОказаниеУслуг.СуммаДокумента КАК СуммаДокумент,
	               |	ОказаниеУслуг.Организация КАК Организация
	               |ИЗ
	               |	Документ.ОказаниеУслуг КАК ОказаниеУслуг
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Дата УБЫВ";

	Результат = Запрос.Выполнить().Выбрать();
	
	Пока результат.Следующий() Цикл
		
		Если УникальныйСчетФактура(Результат.Ссылка) = Ложь Тогда
			Сообщить(Результат.Ссылка);
			счф = Документы.СчетФактураВыданный.СоздатьДокумент();
			ОбработкаЗаполненияСЧФ(счф, Результат);
			счф.Контрагент = Справочники.Контрагенты.НайтиПоНаименованию("Физическое лицо");
			Сообщить("счф.Контрагент " + счф.Контрагент);
			счф.ДоговорКонтрагента = Справочники.ДоговорыКонтрагентов.НайтиПоНаименованию("Основной договор");
			Сообщить("счф.ДоговорКонтрагента " + счф.ДоговорКонтрагента);
			счф.Дата = ТекущаяДата();
			счф.КодВидаОперации = "01";
			счф.Руководитель = Справочники.ФизическиеЛица.НайтиПоНаименованию("Малышева Елена Владимировна");
			счф.ГлавныйБухгалтер = Справочники.ФизическиеЛица.НайтиПоНаименованию("Малышева Елена Владимировна");
			счф.Ответственный = Справочники.Пользователи.НайтиПоНаименованию("Обмен данными");
			счф.ВидСчетаФактуры    	 = Перечисления.ВидСчетаФактурыВыставленного.НаРеализацию;
			счф.Выставлен = Истина;
			счф.ДатаВыставления = ТекущаяДата();
			счф.КодСпособаВыставления = "1";
			счф.Сумма =     Результат.СуммаДокумент;
			счф.Комментарий = "На основании документа оказания услуг из такси (Автоматически)";
			счф.Записать(РежимЗаписиДокумента.Запись);
			
        КонецЕсли;
	 	
	КонецЦикла;
	
КонецПроцедуры

Функция УникальныйСчетФактура(ДокументОснование)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СчетФактураВыданный.Ссылка КАК Ссылка,
	               |	СчетФактураВыданный.ДокументОснование КАК ДокументОснование
	               |ИЗ
	               |	Документ.СчетФактураВыданный КАК СчетФактураВыданный
	               |ГДЕ
	               |	СчетФактураВыданный.ДокументОснование = &ДокументОснование
				   |	И  СчетФактураВыданный.ПометкаУдаления = Ложь";
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	результат = запрос.Выполнить().Выгрузить();
	Если результат.Количество() > 0 Тогда 
		Возврат Истина
	Иначе	
		Возврат	Ложь
	КонецЕсли;
КонецФункции

Процедура ОбработкаЗаполненияСЧФ(счф,Основание)

    счф.Дата = Основание.Дата;
	Сообщить("счф.Дата " + Основание.Дата);
    счф.Организация = Основание.Организация;
    Сообщить("счф.Организация " + Основание.Организация);
    счф.ДокументыОснования.Добавить().ДокументОснование = Основание.Ссылка;
    Сообщить("счф.ДокументыОснования.Добавить().ДокументОснование " + Основание.Ссылка);
    ДокументОснование = Основание.Ссылка;
        
КонецПроцедуры

