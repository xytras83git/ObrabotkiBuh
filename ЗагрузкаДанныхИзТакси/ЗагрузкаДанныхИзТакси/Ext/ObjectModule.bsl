			"Элемент справочника создан, но пользователь информационной базы не найден");
	КонецЕсли;

	Возврат Новый Структура("Ошибка,ИдентификаторПользователяИБ",
		Ложь, Строка(ПользовательИБ.УникальныйИдентификатор));

