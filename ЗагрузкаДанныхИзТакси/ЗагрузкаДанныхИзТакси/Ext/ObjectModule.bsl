Функция СкопироватьПрофильВБазы(СтруктураПараметров)

	Если НЕ СтруктураПараметров.Свойство("ИмяПрофиля") Тогда
		Возврат ПолучитьРезультатСОшибкой("Не передан параметр ИмяПрофиля");
	КонецЕсли;

	Если НЕ СтруктураПараметров.Свойство("ТаблицаРолей") Тогда
		Возврат ПолучитьРезультатСОшибкой("Не передан параметр ТаблицаРолей");
	КонецЕсли;

	ТаблицаРолей = ПреобразоватьТаблицуИзМассиваСтрок(СтруктураПараметров, "ТаблицаРолей");
	СсылкиРолей = Новый Массив;

	Для Каждого СтрокаРоль Из ТаблицаРолей Цикл
		СсылкаРоли = Справочники.ИдентификаторыОбъектовМетаданных.НайтиПоРеквизиту(
			"ПолноеИмя", СтрокаРоль.ПолноеИмя);
		Если НЕ ЗначениеЗаполнено(СсылкаРоли) Тогда
			ТекстОшибки = "Роль не найдена в базе: " + СтрокаРоль.ПолноеИмя;
			Возврат ПолучитьРезультатСОшибкой(ТекстОшибки);
		КонецЕсли;
		СсылкиРолей.Добавить(СсылкаРоли);
	КонецЦикла;

	СправочникПрофиль = Справочники.ПрофилиГруппДоступа.НайтиПоНаименованию(
		СтруктураПараметров.ИмяПрофиля, Истина);
	Если ЗначениеЗаполнено(СправочникПрофиль) Тогда
		СправочникПрофиль = СправочникПрофиль.ПолучитьОбъект();
	Иначе
		СправочникПрофиль = Справочники.ПрофилиГруппДоступа.СоздатьЭлемент();
		СправочникПрофиль.Наименование = СтруктураПараметров.ИмяПрофиля;
	КонецЕсли;

	СправочникПрофиль.Роли.Очистить();
	Для Каждого СсылкаРоли Из СсылкиРолей Цикл
		НоваяСтрока = СправочникПрофиль.Роли.Добавить();
		НоваяСтрока.Роль = СсылкаРоли;
	КонецЦикла;

	СправочникПрофиль.Записать();

	Возврат Новый Структура("Ошибка", Ложь);

