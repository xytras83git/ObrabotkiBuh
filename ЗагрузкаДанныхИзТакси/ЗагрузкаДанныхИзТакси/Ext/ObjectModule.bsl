Функция ПоискРасходовБудущихПериодов(СтруктураДокумент)
	
	Результат = Новый Структура();
	
	ДатаНачала 		= ДатаИзСтроки(СтруктураДокумент.ДатаНачала);
	ДатаОкончания 	= ДатаИзСтроки(СтруктураДокумент.ДатаОкончания);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РасходыБудущихПериодов.Ссылка КАК Ссылка,
		|	РасходыБудущихПериодов.Наименование КАК Наименование,
		|	РасходыБудущихПериодов.ДатаНачалаСписания КАК ДатаНачалаСписания,
		|	РасходыБудущихПериодов.ДатаОкончанияСписания КАК ДатаОкончанияСписания,
		|	РасходыБудущихПериодов.Сумма КАК Сумма
		|ИЗ
		|	Справочник.РасходыБудущихПериодов КАК РасходыБудущихПериодов
		|ГДЕ
		|	РасходыБудущихПериодов.Наименование ПОДОБНО ""%"" + &Госномер + ""%""
		|	И НачалоПериода(РасходыБудущихПериодов.ДатаНачалаСписания, День) = &ДатаНачала";
	
	Запрос.УстановитьПараметр("Госномер", 	СтруктураДокумент.Госномер);
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат.Вставить("Действие", "Найден элемент"); 
		Результат.Вставить("ЭлементСправочника", Выборка.Ссылка);
		
		ЭлементРБПОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ЭлементРБПОбъект.Наименование 				= "ОСАГО "+СтруктураДокумент.Госномер+" с "+Формат(ДатаНачала, "ДФ=dd.MM.yy") + " по "+ Формат(ДатаОкончания, "ДФ=dd.MM.yy");
		ЭлементРБПОбъект.Записать();
		
	Иначе 
		Результат.Вставить("Действие", "Создание элемента");
		ЭлементРБПОбъект = Справочники.РасходыБудущихПериодов.СоздатьЭлемент();
		ЭлементРБПОбъект.Наименование 				= "ОСАГО "+СтруктураДокумент.Госномер+" с "+Формат(ДатаНачала, "ДФ=dd.MM.yy") + " по "+ Формат(ДатаОкончания, "ДФ=dd.MM.yy");
		ЭлементРБПОбъект.ДатаНачалаСписания 		= ДатаНачала;
		ЭлементРБПОбъект.ДатаОкончанияСписания 		= ДатаОкончания;
		ЭлементРБПОбъект.Сумма						= СтруктураДокумент.ЦенаСтраховки;
		ЭлементРБПОбъект.ВидАктива 					= Перечисления.ВидыАктивовДляРБП.ПрочиеОборотныеАктивы;
		ЭлементРБПОбъект.ВидРБП						= Перечисления.ВидыРБП.Прочие;	
		ЭлементРБПОбъект.СпособПризнанияРасходов	= Перечисления.СпособыПризнанияРасходов.ПоМесяцам;
		ЭлементРБПОбъект.СчетЗатрат 				= ПланыСчетов.Хозрасчетный.НайтиПоКоду("26");
		ЭлементРБПОбъект.СубконтоЗатрат1 			= Справочники.СтатьиЗатрат.НайтиПоНаименованию("ОСАГО", Истина);
		
		ЭлементРБПОбъект.Комментарий = "Перенос из такси новый";
		ЭлементРБПОбъект.Записать(); 
		
		Результат.Вставить("ЭлементСправочника", ЭлементРБПОбъект.Ссылка);

	КонецЕсли;
	
	Возврат Результат
		
КонецФункции 

Функция СоздатьДокументОСАГО(СтруктураДокумент)
		
	//Результат = Новый Структура();
	Результат = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(СтруктураДокумент);
	
	//управляем датой на стороне Такси!
	ДатаДокумента = ДатаИзСтроки(СтруктураДокумент.ДатаДокумента);
	
	Если НЕ ТипЗнч(ДатаДокумента) = Тип("Дата") Тогда
		Возврат Новый Структура("Статус, Сообщение", "Ложь", "Не удалось распознать дату документа!");
	ИначеЕсли Год(ДатаДокумента) < 2020 Тогда
		Возврат Новый Структура("Статус, Сообщение", "Ложь", "Некорректная дата документа!");
	ИначеЕсли НЕ ЗначениеЗаполнено(СтруктураДокумент.СтраховщикИНН) Тогда
		Возврат Новый Структура("Статус, Сообщение", "Ложь", "Не указан ИНН страховщика!");
	КонецЕсли;
	
	ПоискДокумента = ПоискДокументаОСАГО(ДатаДокумента, СтруктураДокумент.Госномер);
	
	Если ПоискДокумента.Статус = "Документ найден" Тогда 
		ДокументСсылка = ПоискДокумента.Документ;
		ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
		ДокументБылНайден = Истина;
	Иначе
		
		Результат.Вставить("Статус", ПоискДокумента.Статус);
		
		ДокументОбъект = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент();
		
		ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийПоступлениеТоваровУслуг.Услуги;
		ДокументОбъект.Дата 			= ДатаДокумента;
		 
		ДокументОбъект.Организация		= Справочники.Организации.НайтиПоРеквизиту("ИНН", СтруктураДокумент.ИннСобственник);
		ДокументБылНайден = Ложь;
	КонецЕсли;
	
	
	ДокументОбъект.НомерВходящегоДокумента = СтрЗаменить(СтруктураДокумент.Полис, " ", "");
	ДокументОбъект.ДатаВходящегоДокумента = ДатаДокумента;

	ДокументОбъект.ВалютаДокумента		= Константы.ВалютаРегламентированногоУчета.Получить();
	ДокументОбъект.Контрагент 			= Справочники.Контрагенты.НайтиПоРеквизиту("ИНН", СтруктураДокумент.СтраховщикИНН);
	//для Драйва отдельная ветка
	Если ДатаДокумента > Дата("20230501") Тогда 
		ДатаНачала 		= ДатаИзСтроки(СтруктураДокумент.ДатаНачала);
		НомерПолиса = СтрЗаменить(СтруктураДокумент.Полис, " ", "");
		НомерПолиса = СтрЗаменить(НомерПолиса, "ХХХ", "");
		НаименованиеДоговора = "Полис ОСАГО № ХХХ"+ НомерПолиса +" от " + Формат(ДатаНачала, "ДФ=dd.MM.yyyy"); 
		ПоискДоговора = СоздатьСправочникДоговоров(ДокументОбъект.Контрагент, ДокументОбъект.Организация, НаименованиеДоговора, Истина);
		ДокументОбъект.ДоговорКонтрагента	= ПоискДоговора.Договор;
		
		Результат.Вставить("НовыйДоговор", 			НаименованиеДоговора);
		Результат.Вставить("ДоговорНайденный", 		Строка(ДокументОбъект.ДоговорКонтрагента));
		Результат.Вставить("ДоговорНайден", 		Строка(ПоискДоговора.Найден));
		Результат.Вставить("НаименованиеСоздания", 	Строка(ПоискДоговора.НаименованиеСоздания)); 
		Результат.Вставить("НаименованиеНовогоДоговора", 	Строка(ПоискДоговора.НаименованиеНовогоДоговора)); 		
		
	Иначе
		Если СтруктураДокумент.ИннСобственник = "7724351790" Тогда
			ПоискДоговора = СоздатьСправочникДоговоров(ДокументОбъект.Контрагент, ДокументОбъект.Организация, "Без договора", Истина);
			ДокументОбъект.ДоговорКонтрагента	= ПоискДоговора.Договор;
		Иначе
			ПоискДоговора = СоздатьСправочникДоговоров(ДокументОбъект.Контрагент, ДокументОбъект.Организация, "Основной договор", Истина);
			ДокументОбъект.ДоговорКонтрагента	= ПоискДоговора.Договор;
		КонецЕсли;
	КонецЕсли;
    ДокументОбъект.Комментарий 			= "Перенос из такси новый";
	
	ДокументОбъект.НДСВключенВСтоимость = Истина;
	
	ДокументОбъект.СпособЗачетаАвансов  			= Перечисления.СпособыЗачетаАвансов.Автоматически;
	ДокументОбъект.СчетУчетаРасчетовСКонтрагентом 	= ПланыСчетов.Хозрасчетный.НайтиПоКоду("60.01");
	ДокументОбъект.СчетУчетаРасчетовПоАвансам 		= ПланыСчетов.Хозрасчетный.НайтиПоКоду("60.02");
	
	ДокументОбъект.Услуги.Очистить();
	
	НоваяСтрока = ДокументОбъект.Услуги.Добавить();
	НоваяСтрока.Номенклатура 	= Справочники.Номенклатура.НайтиПоНаименованию("ОСАГО", Истина);
	НоваяСтрока.Содержание 		= "ОСАГО";
	НоваяСтрока.Количество		= 1;
	НоваяСтрока.Цена			= СтруктураДокумент.ЦенаСтраховки;
	НоваяСтрока.Сумма			= СтруктураДокумент.ЦенаСтраховки;
	НоваяСтрока.СтавкаНДС		= Перечисления.СтавкиНДС.БезНДС;
	НоваяСтрока.ОтражениеВУСН	= Перечисления.ОтражениеВУСН.Принимаются;
	НоваяСтрока.СчетЗатрат		= ПланыСчетов.Хозрасчетный.НайтиПоКоду("97.21");
	
	СтруктураРБП = ПоискРасходовБудущихПериодов(СтруктураДокумент);
	НоваяСтрока.Субконто1		= СтруктураРБП.ЭлементСправочника;
	
	Если УчетнаяПолитика.СистемаНалогообложения(ДокументОбъект.Организация, ДатаДокумента) = Перечисления.СистемыНалогообложения.Общая Тогда
		НоваяСтрока.СчетЗатратНУ	= ПланыСчетов.Хозрасчетный.НайтиПоКоду("97.21");
		НоваяСтрока.СубконтоНУ1		= СтруктураРБП.ЭлементСправочника;
	КонецЕсли;

	Попытка
		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		Результат.Вставить("ОписаниеОшибки", 	Строка(ОписаниеОшибки()));
		Результат.Вставить("Статус", 			"Ложь");
		ДополнитьРезультатЛогированияДокумента(Результат, ДокументОбъект, "ОСАГО", ДокументБылНайден);
		Возврат Результат;
	КонецПопытки;
	
	Попытка
		
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Результат.Вставить("Статус", 			"Истина");
		Результат.Вставить("ДокументПроведен", 	"Истина");	
		
	Исключение                              
		Результат.Вставить("Статус", 	"Ложь");
		//Результат.Вставить("Сообщение", 				Строка(ОписаниеОшибки()));	
		//Результат.Вставить("ОписаниеОшибки", 			Строка(ОписаниеОшибки()));	
		Результат.Вставить("НеУдалосьЗаписатьПроводки", "Истина");	
	КонецПопытки;
	
	ДополнитьРезультатЛогированияДокумента(Результат, ДокументОбъект, "ОСАГО", ДокументБылНайден);
	Возврат Результат;	
	
КонецФункции 

