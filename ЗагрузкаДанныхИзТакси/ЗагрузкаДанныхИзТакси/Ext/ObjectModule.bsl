Функция СоздатьСправочникКонтрагентов(КонтрагентНаименование, КодВодителя = "")
	
	Попытка
		
		//Шихалиев Т.Р. 22.05.2026++
		КонтрагентНаименование = НормализоватьСтрокуОбмена(КонтрагентНаименование);
		КодВодителя = НормализоватьСтрокуОбмена(КодВодителя);
		//Шихалиев Т.Р. 22.05.2026--
	
		КонтрагентСсылка = Справочники.Контрагенты.НайтиПоНаименованию(КонтрагентНаименование, истина);
		Если ЗначениеЗаполнено(КонтрагентСсылка) Тогда
			//Шихалиев Т.Р. 22.05.2026++
			Если ЗначениеЗаполнено(КодВодителя) И КодВодителя <> "000000000" Тогда
				ОбновитьКодВодителя(КонтрагентСсылка, КодВодителя);
			КонецЕсли;
			//Шихалиев Т.Р. 22.05.2026--
			Возврат Новый Структура("Статус, Контрагент", Истина, КонтрагентСсылка);
		Иначе
			НовыйКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
			НовыйКонтрагент.Наименование = КонтрагентНаименование;
			НовыйКонтрагент.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо;
			НовыйКонтрагент.Комментарий = "Перенос из такси новый";
			НовыйКонтрагент.Записать();
			
			// Записываем код водителя если он заполнен и не "000000000"
			Если ЗначениеЗаполнено(КодВодителя) И КодВодителя <> "000000000" Тогда
				ОбновитьКодВодителя(НовыйКонтрагент.Ссылка, КодВодителя);
			КонецЕсли;
			
			Возврат Новый Структура("Статус, Контрагент", Истина, НовыйКонтрагент.Ссылка);
		КонецЕсли;
		
		Возврат Новый Структура("Статус, Сообщение", Ложь, "Не удалось создать контрагента2");
		
	Исключение   
		Возврат Новый Структура("Статус, Сообщение", Ложь, "Не удалось создать контрагента");
	КонецПопытки;
	
КонецФункции

Функция СоздатьСправочникДоговоров(Контрагент, Организация, НаименованиеДоговора = "", ЭтоОсаго = Ложь)
	
	Результат = Новый Структура();
	
	Если ЭтоОсаго Тогда
		ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком;
	Иначе
		ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДоговорыКонтрагентов.Ссылка КАК Договор
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	ДоговорыКонтрагентов.Владелец = &Владелец
		|	И ДоговорыКонтрагентов.ВидДоговора = &ВидДоговора
		|	И ДоговорыКонтрагентов.ПометкаУдаления = ЛОЖЬ
		|	И ДоговорыКонтрагентов.Организация = &Организация
		|	И ДоговорыКонтрагентов.Наименование ПОДОБНО &Наименование";
		
		Если ЭтоОсаго Тогда
			
		Иначе
			Запрос.Текст = Запрос.Текст + "
			|	И (ВЫРАЗИТЬ(ДоговорыКонтрагентов.Комментарий КАК СТРОКА(150))) Подобно ""%Перенос из такси%""";
		КонецЕсли;
		
	Запрос.УстановитьПараметр("Наименование", 	"%"+НаименованиеДоговора+"%");
	Запрос.УстановитьПараметр("Владелец", 		Контрагент);
	Запрос.УстановитьПараметр("Организация", 	Организация);
	Запрос.УстановитьПараметр("ВидДоговора", 	ВидДоговора);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат.Вставить("Договор", 						Выборка.Договор);
		Результат.Вставить("НаименованиеСоздания", 			НаименованиеДоговора);
		Результат.Вставить("НаименованиеНовогоДоговора", 	"");	
		Результат.Вставить("Найден", 						"Истина"); 
		Возврат Результат;
	Иначе
		
		НовыйДоговор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
		НовыйДоговор.Организация 			= Организация;
		НовыйДоговор.Владелец 				= Контрагент;                        
		НовыйДоговор.ВидДоговора 			= ВидДоговора;
		НовыйДоговор.ВалютаВзаиморасчетов 	= Справочники.Валюты.НайтиПоКоду("643", Ложь);
		НовыйДоговор.Наименование 			= ?(НаименованиеДоговора = "", "Основной договор", НаименованиеДоговора);
		НовыйДоговор.Комментарий 			= "Перенос из такси новый";
		НовыйДоговор.ОбменДанными.Загрузка	= Истина;
		НовыйДоговор.Записать();
				
		Если НЕ ЭтоОсаго Тогда		
			НоваяЗапись = РегистрыСведений.ОсновныеДоговорыКонтрагента.СоздатьМенеджерЗаписи();
			НоваяЗапись.Организация = Организация;
			НоваяЗапись.Контрагент  = Контрагент;
			НоваяЗапись.ВидДоговора = ВидДоговора;
			НоваяЗапись.Договор     = НовыйДоговор.Ссылка;
			НоваяЗапись.Записать(Истина);
		КонецЕсли;      
		
		Результат.Вставить("Договор", 						НовыйДоговор.Ссылка);
		Результат.Вставить("НаименованиеСоздания", 			НаименованиеДоговора);
		Результат.Вставить("НаименованиеНовогоДоговора", 	НовыйДоговор.Наименование);	
		Результат.Вставить("Найден", 						"Ложь"); 
		Возврат Результат;		
		
	КонецЕсли;
			
КонецФункции

