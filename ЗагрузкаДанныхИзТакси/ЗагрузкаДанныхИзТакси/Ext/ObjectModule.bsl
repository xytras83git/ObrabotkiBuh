Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("2.3.2.45");  
	ПараметрыРегистрации.Вид =
	ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	ПараметрыРегистрации.БезопасныйРежим = Ложь;
	ПараметрыРегистрации.Наименование = Метаданные().Имя;
	ПараметрыРегистрации.Версия = Метаданные().Комментарий; 

	
	НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
	НоваяКоманда.Представление = Метаданные().Синоним;
	НоваяКоманда.Идентификатор = Метаданные().Имя;  
	НоваяКоманда.Использование =
	ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	НоваяКоманда.ПоказыватьОповещение = Истина;

	Разрешение = РаботаВБезопасномРежиме.РазрешениеНаИспользованиеКаталогаВременныхФайлов(Истина, Истина, "Чтение и запись файла Excel во временном каталоге");	
	ПараметрыРегистрации.Разрешения.Добавить(Разрешение);
	
	Разрешение = РаботаВБезопасномРежиме.РазрешениеНаИспользованиеПривилегированногоРежима("Для печати под неполными правами требуется..");
	ПараметрыРегистрации.Разрешения.Добавить(Разрешение);
	
	Возврат ПараметрыРегистрации;
		
КонецФункции

#region ОбщиеФункции 

Функция ПолучитьРезультатСОшибкой(ТекстОшибки)
	Результат = Новый Структура();
	Результат.Вставить("Ошибка", Истина);
	Результат.Вставить("ОписаниеОшибки", ТекстОшибки);
	Возврат Результат;
КонецФункции

Функция ПолучитьВТ(МенеджерВТ, ИмяВТ) Экспорт
  
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Текст = "ВЫБРАТЬ
	| *
	|ИЗ
	| "+ИмяВТ+" КАК ВТ";
	Попытка
		Возврат Запрос.Выполнить().Выгрузить();
	Исключение
		Возврат "Ошибка получения временной таблицы: "
		+ ОписаниеОшибки();
	КонецПопытки;
  
КонецФункции

Процедура ПроверкаСтруктуры(СтруктураВнешнихДанных, СтрокаПолей = "") Экспорт
	ПроверкаСтруктуры = "";
	Если ТипЗнч(СтруктураВнешнихДанных) <> Тип("Структура") Тогда
		Сообщить("Проверяемая структура не является структурой - " + ТипЗнч(СтруктураВнешнихДанных));
	КонецЕсли;
	Для каждого ИмяСвойства из СтруктураВнешнихДанных Цикл
		Если НЕ СтрокаПолей = ""Тогда
			Если Найти(СтрокаПолей, ИмяСвойства.Ключ) = 0 Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		ПроверкаСтруктуры = ПроверкаСтруктуры + ИмяСвойства.Ключ+ ": "+ ИмяСвойства.Значение+ ";";
	КонецЦикла;
	//Если РольДоступна("ПолныеПрава") Тогда
		Сообщить(ПроверкаСтруктуры);
	//КонецЕсли;
КонецПроцедуры

Функция ДатаИзСтроки(ДатаСтрока)
	Попытка
		ЧастьДата = Сред(ДатаСтрока, 7, 4) + Сред(ДатаСтрока, 4, 2) + Лев(ДатаСтрока, 2);
		ЧастьВремя = "";
		Счетчик = 1;       
		
		//начало поиска времени - " "
		ПоискС = СтрНайти(ДатаСтрока, " ", НаправлениеПоиска.СНачала, 9);
		ИндексДвоеточия = СтрНайти(ДатаСтрока, ":", НаправлениеПоиска.СНачала, ПоискС);
		Пока Счетчик <= 3 Цикл
			
			ЧастьВремя = ЧастьВремя + СтроковыеФункцииКлиентСервер.ДополнитьСтроку(Сред(ДатаСтрока, ПоискС + 1, ИндексДвоеточия - ПоискС - 1), 2, "0");
			
			ПоискС = ИндексДвоеточия;
			ИндексДвоеточия = СтрНайти(ДатаСтрока, ":", НаправлениеПоиска.СНачала, ПоискС + 1);
			Счетчик = Счетчик + 1;
		КонецЦикла;
		
		Возврат Дата(ЧастьДата + ЧастьВремя);
		
	Исключение
		
		Возврат Дата("20000101");
	КонецПопытки;
КонецФункции

Функция СоздатьСтатьюДДС(НаименованиеСтатьи)
	
	СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоНаименованию(НаименованиеСтатьи, Истина);
	Если НЕ ЗначениеЗаполнено(СтатьяДДС) Тогда
		СправочникОбъект = Справочники.СтатьиДвиженияДенежныхСредств.СоздатьЭлемент();
		СправочникОбъект.Наименование = НаименованиеСтатьи;
		СправочникОбъект.Записать();
		СтатьяДДС = СправочникОбъект.Ссылка;
	КонецЕсли;
	
	Возврат СтатьяДДС;
	
КонецФункции

Функция СоздатьПрочиеДоходыИРасходы(НаименованиеСтатьи)
	
	СтатьяПДР = Справочники.ПрочиеДоходыИРасходы.НайтиПоНаименованию(НаименованиеСтатьи, Истина);
	Если НЕ ЗначениеЗаполнено(СтатьяПДР) Тогда
		СправочникОбъект = Справочники.ПрочиеДоходыИРасходы.СоздатьЭлемент();
		СправочникОбъект.Наименование = НаименованиеСтатьи;
		СправочникОбъект.Записать();
		СтатьяПДР = СправочникОбъект.Ссылка;
	КонецЕсли;
	
	Возврат СтатьяПДР;
	
КонецФункции

Функция ПолучитьДатуЗапретаИзменения()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДатыЗапретаИзменения.ДатаЗапрета КАК ДатаЗапрета
		|ПОМЕСТИТЬ ВТ_ЗапретИзмененияБухгалтер
		|ИЗ
		|	РегистрСведений.ДатыЗапретаИзменения КАК ДатыЗапретаИзменения
		|ГДЕ
		|	ДатыЗапретаИзменения.Пользователь = &Пользователь
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ВТ_ЗапретИзмененияБухгалтер.ДатаЗапрета ЕСТЬ NULL
		|			ТОГДА ДатыЗапретаИзменения.ДатаЗапрета
		|		ИНАЧЕ ВТ_ЗапретИзмененияБухгалтер.ДатаЗапрета
		|	КОНЕЦ КАК ДатаЗапретаТекущая
		|ИЗ
		|	РегистрСведений.ДатыЗапретаИзменения КАК ДатыЗапретаИзменения
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЗапретИзмененияБухгалтер КАК ВТ_ЗапретИзмененияБухгалтер
		|		ПО (ИСТИНА)
		|ГДЕ
		|	ДатыЗапретаИзменения.Пользователь.Наименование ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("Пользователь", Справочники.Пользователи.НайтиПоНаименованию("ОбменДанными", Истина));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.ДатаЗапретаТекущая;
	КонецЦикла;
	
КонецФункции

Функция ПодготовитьСтруктуруКВыгрузке(СтруктураВнешнихДанных)
	
	Результат = Новый Структура();
	
	Для каждого ИмяСвойства из СтруктураВнешнихДанных Цикл 
				
		Результат.Вставить(ИмяСвойства.Ключ, ?(ТипЗнч(ИмяСвойства.Значение) = Тип("Строка") ИЛИ ТипЗнч(ИмяСвойства.Значение) = Тип("Число"), ИмяСвойства.Значение, Строка(ИмяСвойства.Значение)));
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПреобразоватьТаблицуВМассивСтрокДляВыгрузки(ТаблицаПроверка, ПреобразоватьДляОбмена = Ложь)
	
	РезультатПустой = Новый Структура();
	Для каждого Колонка из ТаблицаПроверка.Колонки Цикл	
		//Сообщить("Колонка.Имя " + Колонка.Имя);	
		РезультатПустой.Вставить(Колонка.Имя, "");
	КонецЦикла;
	
	МассивСтрок = Новый Массив;
	Для каждого СтрокаТаблицы из ТаблицаПроверка Цикл	
		
		РезультатСтрока = ОбщегоНазначения.СкопироватьРекурсивно(РезультатПустой);
		
		ЗаполнитьЗначенияСвойств(РезультатСтрока, СтрокаТаблицы); 
		
		Если ПреобразоватьДляОбмена Тогда
			РезультатСтрока = ПодготовитьСтруктуруКВыгрузке(РезультатСтрока);
		КонецЕсли;
		
		МассивСтрок.Добавить(РезультатСтрока);
		
	КонецЦикла;	
		
	Возврат МассивСтрок;
	
КонецФункции

Функция СоздатьТаблицуЗначенийПоСтруктуре(СтруктураСКолонками)
	
	КвалификаторыСтроки = Новый КвалификаторыСтроки(50);
	КвалификаторыСтроки150 = Новый КвалификаторыСтроки(150);
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	Для каждого ИмяСвойства из СтруктураСКолонками Цикл
				
		//Torbyak 22.09.2026++
		Если ИмяСвойства.Ключ = "ПолноеИмя" Тогда
			ТипКолонки = Новый ОписаниеТипов("Строка");
		ИначеЕсли Найти(ИмяСвойства.Ключ, "Дата") > 0 ИЛИ Найти(ИмяСвойства.Ключ, "Период") > 0 Тогда
			ТипКолонки = Новый ОписаниеТипов("Дата");			
		ИначеЕсли Найти(ИмяСвойства.Ключ, "ОбъектОсмотра") > 0 Тогда
			ТипКолонки = Новый ОписаниеТипов("СправочникСсылка.Элемент_ОбъектыОсмотра");
		ИначеЕсли Найти(ИмяСвойства.Ключ, "СтепеньПовреждения") > 0 Тогда
			ТипКолонки = Новый ОписаниеТипов("СправочникСсылка.Элемент_ВозможныеСостояния");
		ИначеЕсли Найти(ИмяСвойства.Ключ, "Марка") > 0 Тогда 
			ТипКолонки = Новый ОписаниеТипов("СправочникСсылка.МаркиАМ");
		ИначеЕсли Найти(ИмяСвойства.Ключ, "Модель") > 0 Тогда  
			ТипКолонки = Новый ОписаниеТипов("СправочникСсылка.МодельАМ");
		ИначеЕсли  Найти(ИмяСвойства.Ключ, "ФИО") > 0 Тогда
			ТипКолонки = Новый ОписаниеТипов("Строка", ,КвалификаторыСтроки150);
		ИначеЕсли ТипЗнч(ИмяСвойства.Значение) = Тип("Строка") Тогда 
			ТипКолонки = Новый ОписаниеТипов("Строка", ,КвалификаторыСтроки);
		ИначеЕсли ТипЗнч(ИмяСвойства.Значение) = Тип("Число") Тогда 
			ТипКолонки = Новый ОписаниеТипов("Число");
		КонецЕсли;
		//Torbyak 22.09.2026--
				
		ТаблицаРезультат.Колонки.Добавить(ИмяСвойства.Ключ, ТипКолонки);
	КонецЦикла;	
	
	Возврат ТаблицаРезультат;
	
КонецФункции

Функция ПолучитьПустуюТаблицуПоОперации(ИмяПараметра)   
	
	СтруктураСКолонками = Новый Структура("Номер, Дата", "", Дата("00010101"));
	Если ИмяПараметра = "МассивЗаявок" Тогда
		СтруктураСКолонками.Вставить("Период", 					Дата("00010101")); 
		СтруктураСКолонками.Вставить("Номенклатура",			"");
		СтруктураСКолонками.Вставить("ОбъектОсмотра",			"");
		СтруктураСКолонками.Вставить("СтепеньПовреждения",		"");
		СтруктураСКолонками.Вставить("ДокументОсмотр",			"");
		СтруктураСКолонками.Вставить("Стоимость",				0);
		СтруктураСКолонками.Вставить("СуммаРемонта",			0);		
	ИначеЕсли ИмяПараметра = "ТаблицаСЦенами" Тогда
		СтруктураСКолонками.Вставить("УИД_Осмотра",				"");
		СтруктураСКолонками.Вставить("ОбъектОсмотра", 			""); 
		СтруктураСКолонками.Вставить("ДатаОсмотра", 			""); 		
		СтруктураСКолонками.Вставить("Марка",					"");
		СтруктураСКолонками.Вставить("Модель",					"");
		СтруктураСКолонками.Вставить("Цена",					"");
		СтруктураСКолонками.Вставить("ДатаЦены",				"");
		СтруктураСКолонками.Вставить("Документ",				"");
	КонецЕсли;
	
	ТаблицаРезультат = СоздатьТаблицуЗначенийПоСтруктуре(СтруктураСКолонками);
		
	Возврат ТаблицаРезультат;
КонецФункции

Функция ПреобразоватьСтруктуруСтрокВДанные(СтруктураСтрок)
	
	Результат = Новый Структура();
	Для каждого ИмяСвойства из СтруктураСтрок Цикл
		Если Найти(ИмяСвойства.Ключ, "Дата") > 0 ИЛИ Найти(ИмяСвойства.Ключ, "Период") > 0 Тогда
			ЗначениеСвойства = ДатаИзСтроки(ИмяСвойства.Значение); 
			//Сообщить("ЗначениеСвойства " + ЗначениеСвойства);
		//ИначеЕсли Найти(ИмяСвойства.Ключ, "ОбъектОсмотра") > 0 Тогда
		//	ЗначениеСвойства = Справочники.Элемент_ОбъектыОсмотра.НайтиПоНаименованию(ИмяСвойства.Значение, Истина);
		ИначеЕсли Найти(ИмяСвойства.Ключ, "СтепеньПовреждения") > 0 Тогда
			ЗначениеСвойства = Справочники.Элемент_ВозможныеСостояния.НайтиПоНаименованию(ИмяСвойства.Значение, Истина);
		ИначеЕсли Найти(ИмяСвойства.Ключ, "Марка") > 0 Тогда
			ЗначениеСвойства = Справочники.МаркиАМ.НайтиПоНаименованию(ИмяСвойства.Значение, Истина);
		//ИначеЕсли Найти(ИмяСвойства.Ключ, "Модель") > 0 Тогда
		//	ЗначениеСвойства = НайтиМодельПоНаименованию(ИмяСвойства.Значение);
		Иначе
			ЗначениеСвойства = ИмяСвойства.Значение; 
		КонецЕсли; 
		
		Результат.Вставить(ИмяСвойства.Ключ, ЗначениеСвойства);
		
	КонецЦикла;	
	
	Возврат Результат;
	
КонецФункции

Функция ПреобразоватьТаблицуИзМассиваСтрок(ДанныеИзТакси, ИмяПараметра)
	
	//Сообщить("ИмяПараметра  " +ИмяПараметра);
	МассивСтрок = ДанныеИзТакси[ИмяПараметра];
	//Сообщить("МассивСтрок.Количество() "  +  МассивСтрок.Количество()); 
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат ПолучитьПустуюТаблицуПоОперации(ИмяПараметра);
	КонецЕсли;  
	
	ПервыйЭлемент = МассивСтрок[0];  
	ТаблицаРезультат = СоздатьТаблицуЗначенийПоСтруктуре(ПервыйЭлемент);
	
	Для каждого СтрокаМассива из МассивСтрок Цикл
		НоваяСтрока = ТаблицаРезультат.Добавить();
		
		ПреобразованнаяСтруктура = ПреобразоватьСтруктуруСтрокВДанные(СтрокаМассива);
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ПреобразованнаяСтруктура);
	
	КонецЦикла;
			
	Возврат ТаблицаРезультат;
	
КонецФункции

Функция БезопасноеПолучениеСвойстваСтруктуры(СамаСтруктура, ИмяСвойства, ЗначениеПоУмолчанию) Экспорт
	
	Результат = ЗначениеПоУмолчанию;
	Если ТипЗнч(СамаСтруктура) = Тип("Структура") Тогда
		Если СамаСтруктура.Свойство(ИмяСвойства) Тогда
			Результат = СамаСтруктура[ИмяСвойства];
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;	
	
КонецФункции

//Шихалиев Т.Р. 10.06.2026++
Процедура ДополнитьРезультатЛогированияОперации(Результат, ОперацияВыгрузки)
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Результат.Вставить("АвтоматическаяВыгрузка", "Истина");
	Результат.Вставить("ОперацияВыгрузки", ОперацияВыгрузки);
	
КонецПроцедуры

Процедура ДополнитьРезультатЛогированияДокумента(Результат, ДокументОбъект, ОперацияВыгрузки, ДокументНайден = Неопределено)
	
	ДополнитьРезультатЛогированияОперации(Результат, ОперацияВыгрузки);
	
	Если ДокументНайден <> Неопределено Тогда
		Результат.Вставить("ДокументНайден", ?(ДокументНайден, "Истина", "Ложь"));
	КонецЕсли;
	
	Если ДокументОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Результат.Вставить("ДокументСозданныйТип", ДокументОбъект.Метаданные().Имя);
	Результат.Вставить("ПредставлениеДокументаСозданного", Строка(ДокументОбъект.Ссылка));
	Результат.Вставить("ДокументСозданный", Строка(ДокументОбъект.Ссылка));
	Результат.Вставить("НомерСозданногоДокумента", Строка(ДокументОбъект.Номер));
	Результат.Вставить("ДатаСозданногоДокумента", Строка(ДокументОбъект.Дата));
	
	Попытка
		Результат.Вставить("ОрганизацияСозданногоДокумента", Строка(ДокументОбъект.Организация));
	Исключение
	КонецПопытки;
	
	Попытка
