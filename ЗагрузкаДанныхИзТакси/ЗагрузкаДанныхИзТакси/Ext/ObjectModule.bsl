Функция СоздатьДокументОказаниеУслуг(МассивДокументов, ТаблицаКонтрагентов)
		
	Если МассивДокументов.Количество() = 0 Тогда
		Возврат Новый Структура("Статус, Сообщение", "Ложь", "Нет документов к созданию!");
	КонецЕсли;
	
	ПерваяСтрока = МассивДокументов[0];
	
	Результат = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ПерваяСтрока);
	
	ДатаДокумента = ДатаИзСтроки(ПерваяСтрока.ДатаДокумента);
	
	Если НЕ ТипЗнч(ДатаДокумента) = Тип("Дата") Тогда
		Возврат Новый Структура("Статус, Сообщение", "Ложь", "Не удалось распознать дату документа!");
	ИначеЕсли Год(ДатаДокумента) < 2020 Тогда
		Возврат Новый Структура("Статус, Сообщение", "Ложь", "Некорректная дата документа!");
	КонецЕсли;
	
	ДокументСсылка = ПоискДокументаОказаниеУслуг(ДатаДокумента);
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		ДокументОбъект = Документы.ОказаниеУслуг.СоздатьДокумент();
	    ДокументОбъект.ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
	    
	    орг= Справочники.Организации.Выбрать();
	    орг.Следующий() ; 
		ДокументОбъект.Дата 			= ДатаДокумента;
		
		ТекущаяОрганизация = Справочники.Организации.Выбрать();
		ТекущаяОрганизация.Следующий();
		ДокументОбъект.Организация		= ТекущаяОрганизация.Ссылка;
		ДокументБылНайден = Ложь;
	Иначе
		ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
		ДокументОбъект.Контрагенты.Очистить();
		ДокументБылНайден = Истина;
	КонецЕсли;
	
    ДокументОбъект.Номенклатура 	= Справочники.Номенклатура.НайтиПоНаименованию("Аренда", Истина);
	
