		|			ПО ДоговорыКонтрагентов.Ссылка = ОсновныеДоговорыКонтрагента.Договор
		|				И ДоговорыКонтрагентов.Организация = ОсновныеДоговорыКонтрагента.Организация
		|				И ДоговорыКонтрагентов.ВидДоговора = ОсновныеДоговорыКонтрагента.ВидДоговора
		|		ПО ВТ_НайденныеКонтрагентыИтог.Контрагент = ДоговорыКонтрагентов.Владелец
		|			И (ДоговорыКонтрагентов.ПометкаУдаления = ЛОЖЬ)
		|			И (ВЫБОР
		|				КОГДА ВТ_НайденныеКонтрагентыИтог.ДоговорНаименование ПОДОБНО ""%Основной%""
		|					ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПокупателем)
		|				ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.Прочее)
		|			КОНЕЦ = ДоговорыКонтрагентов.ВидДоговора)
		|			И (ДоговорыКонтрагентов.Наименование ПОДОБНО ""%"" + (ВЫРАЗИТЬ(ВТ_НайденныеКонтрагентыИтог.ДоговорНаименование КАК СТРОКА(150))) + ""%"")
		|			И (ВЫРАЗИТЬ(ДоговорыКонтрагентов.Комментарий КАК СТРОКА(150)) ПОДОБНО ""%Перенос из такси%"")
		|			И (ВЫБОР
		|				КОГДА ОсновныеДоговорыКонтрагента.Организация ЕСТЬ NULL
		|					ТОГДА ЛОЖЬ
		|				ИНАЧЕ ИСТИНА
		|			КОНЕЦ)
		|			И ВТ_НайденныеКонтрагентыИтог.Организация = ДоговорыКонтрагентов.Организация";
	
	Запрос.УстановитьПараметр("ТаблицаКонтрагентов", ТаблицаКонтрагентов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТаблицаЗапроса = РезультатЗапроса.Выгрузить();
		
	Возврат ТаблицаЗапроса;
	
КонецФункции

Процедура ДобавитьСтрокуВТаблицуКонтрагентов(ТаблицаКонтрагентов, КонтрагентНаименование, ДоговорНаименование, КодВодителя = "")
	
	//Шихалиев Т.Р. 22.05.2026++
	КонтрагентНаименование = НормализоватьСтрокуОбмена(КонтрагентНаименование);
	ДоговорНаименование = НормализоватьСтрокуОбмена(ДоговорНаименование);
	КодВодителя = НормализоватьСтрокуОбмена(КодВодителя);
	
	Если НЕ ЗначениеЗаполнено(КонтрагентНаименование) Тогда
		Возврат;
	КонецЕсли;
	//Шихалиев Т.Р. 22.05.2026--
	
	//Шихалиев Т.Р. 21.05.2026++
	Если ЗначениеЗаполнено(КодВодителя) И КодВодителя <> "000000000" Тогда
		СтруктураПоиска = Новый Структура("КонтрагентНаименование, КодВодителя", КонтрагентНаименование, КодВодителя);
	Иначе
		СтруктураПоиска = Новый Структура("КонтрагентНаименование", КонтрагентНаименование);
	КонецЕсли;
	//Шихалиев Т.Р. 21.05.2026--
	НайденныеСтроки = ТаблицаКонтрагентов.НайтиСтроки(СтруктураПоиска);

	Если НайденныеСтроки.Количество() = 0 Тогда
		НоваяСтрока = ТаблицаКонтрагентов.Добавить();
		НоваяСтрока.КонтрагентНаименование 	= КонтрагентНаименование;
		НоваяСтрока.ДоговорНаименование 	= ДоговорНаименование;
		//Комиссаров Д.О. 20.06.2025 ((
		НоваяСтрока.КодВодителя				= КодВодителя;
		//Комиссаров Д.О. 20.06.2025 ))
	КонецЕсли;
	
КонецПроцедуры

Функция ОбработатьКонтрагентовИДоговоры(СтруктураПараметров)
	
	ТаблицаКонтрагентов = Новый ТаблицаЗначений();              
	КвалификаторыСтроки = Новый КвалификаторыСтроки(150);
	ТаблицаКонтрагентов.Колонки.Добавить("КонтрагентНаименование", 	Новый ОписаниеТипов("Строка", ,КвалификаторыСтроки));
	ТаблицаКонтрагентов.Колонки.Добавить("ДоговорНаименование", 	Новый ОписаниеТипов("Строка", ,КвалификаторыСтроки));
	ТаблицаКонтрагентов.Колонки.Добавить("КодВодителя",			Новый ОписаниеТипов("Строка", ,КвалификаторыСтроки));
	//Шихалиев Т.Р. 21.05.2026++
	КодВодителя = "";
	//Шихалиев Т.Р. 21.05.2026--
	
	РезультатПоиска = Новый Структура(); 

	Если СтруктураПараметров.Свойство("МассивДокументов") Тогда
		Для каждого ЭлементМассива из СтруктураПараметров.МассивДокументов Цикл
			
			КодНайден = ЭлементМассива.Свойство("КодВодителя");
			Если КодНайден Тогда
				КодВодителя = ЭлементМассива.КодВодителя;
			Иначе 
				КодВодителя = "";
			КонецЕсли;
			
			Если СтруктураПараметров.ТипЗапроса = "ДокументыОказаниеУслуг" ИЛИ СтруктураПараметров.ТипЗапроса = "ДокументыЭквайрингОбмен" Тогда
				
				ДобавитьСтрокуВТаблицуКонтрагентов(ТаблицаКонтрагентов, ЭлементМассива.ВодительНаименование, "Основной", КодВодителя);
				
			ИначеЕсли СтруктураПараметров.ТипЗапроса = "ДокументыАренда" Тогда  
				
				Если Найти(ЭлементМассива.ВыгружаемаяОперация, "ПКО") > 0 ИЛИ Найти(ЭлементМассива.ВыгружаемаяОперация, "РКО") > 0 Тогда
					НаименованиеКонтрагента = ЭлементМассива.КонтрагентКО;
				ИначеЕсли ЭлементМассива.СчетКт = "91.01" Тогда
					НаименованиеКонтрагента = ЭлементМассива.КонтрагентДт;
				Иначе
					НаименованиеКонтрагента = ЭлементМассива.КонтрагентКт;                              
				КонецЕсли;
				
				ДобавитьСтрокуВТаблицуКонтрагентов(ТаблицаКонтрагентов, НаименованиеКонтрагента, "Основной", КодВодителя);

				//Шихалиев Т.Р. 03.04.2026++ КонтрагентДт нужен для СубконтоДт в проводках операций
				Если НЕ ЭлементМассива.СчетКт = "91.01"
					И ЗначениеЗаполнено(ЭлементМассива.КонтрагентДт) Тогда
					ДобавитьСтрокуВТаблицуКонтрагентов(ТаблицаКонтрагентов, ЭлементМассива.КонтрагентДт, ЭлементМассива.ДоговорНаименование, "");
				КонецЕсли;
				//Шихалиев Т.Р. 03.04.2026--

			КонецЕсли;
			
		КонецЦикла;
	ИначеЕсли СтруктураПараметров.Свойство("МассивВодителей") Тогда
		Для каждого ЭлементМассива Из СтруктураПараметров.МассивВодителей Цикл
			НаименованиеКонтрагента = ЭлементМассива;
			ДобавитьСтрокуВТаблицуКонтрагентов(ТаблицаКонтрагентов, НаименованиеКонтрагента, "Основной", КодВодителя);
		КонецЦикла;
	КонецЕсли;

	РезультатПоиска.Вставить("ИзначальноСтрок", ТаблицаКонтрагентов.Количество());
	
	Результат = Новый Структура();
	ТаблицаКонтрагентов = ПоискКонтрагентовИДоговоров(ТаблицаКонтрагентов);
	РезультатПоиска.Вставить("СтрокПослеПоиска", ТаблицаКонтрагентов.Количество());
	
	МассивКонтрагентов = Новый Массив;
	//Шихалиев Т.Р. 21.05.2026++
	МассивКлючейКонтрагентов = Новый Массив;
	//Шихалиев Т.Р. 21.05.2026--
	Для каждого СтрокаЗапроса из ТаблицаКонтрагентов Цикл
	    
	    СтруктураКонтрагент = Новый Структура("Контрагент, Договор, КонтрагентНаименование, Комментарий, КодВодителя");
	    
	    //Шихалиев Т.Р. 21.05.2026++
	    Если ЗначениеЗаполнено(СтрокаЗапроса.КодВодителя) И СтрокаЗапроса.КодВодителя <> "000000000" Тогда
	        КлючКонтрагента = Строка(СтрокаЗапроса.Организация) + "|" + СтрокаЗапроса.КонтрагентНаименование + "|" + СтрокаЗапроса.КодВодителя;
	    Иначе
	        КлючКонтрагента = Строка(СтрокаЗапроса.Организация) + "|" + СтрокаЗапроса.КонтрагентНаименование;
	    КонецЕсли;
	    
	    Если НЕ МассивКлючейКонтрагентов.Найти(КлючКонтрагента) = Неопределено Тогда
	        Продолжить;
	    КонецЕсли;
	    //Шихалиев Т.Р. 21.05.2026--
	    
	    Если НЕ ЗначениеЗаполнено(СтрокаЗапроса.Контрагент) Тогда
	        СтруктураКонтрагент = СоздатьСправочникКонтрагентов(
	            СтрокаЗапроса.КонтрагентНаименование, 
	            СтрокаЗапроса.КодВодителя);
	        
	        Если СтруктураКонтрагент.Статус Тогда
	            СтрокаЗапроса.Контрагент = СтруктураКонтрагент.Контрагент;
	            //Шихалиев Т.Р. 21.05.2026++
	            МассивКлючейКонтрагентов.Добавить(КлючКонтрагента);
	            //Шихалиев Т.Р. 21.05.2026--
	        Иначе
	            СтруктураКонтрагент.Комментарий = СтруктураКонтрагент.Сообщение;
	        КонецЕсли;
	        
	    ИначеЕсли ЗначениеЗаполнено(СтрокаЗапроса.КодВодителя) 
	        И СтрокаЗапроса.КодВодителя <> "000000000"
	        И НЕ ЗначениеЗаполнено(СтрокаЗапроса.КодВодителяНайденный) Тогда
	        
	        РезультатОбновления = ОбновитьКодВодителя(СтрокаЗапроса.Контрагент, СтрокаЗапроса.КодВодителя);
	        
	        Если РезультатОбновления.Статус Тогда
	            СтрокаЗапроса.КодВодителяНайденный = СтрокаЗапроса.КодВодителя;
	        КонецЕсли;
	        
	        //Шихалиев Т.Р. 21.05.2026++
	        МассивКлючейКонтрагентов.Добавить(КлючКонтрагента);
	        //Шихалиев Т.Р. 21.05.2026--
	        
	    Иначе
	        //Шихалиев Т.Р. 21.05.2026++
	        МассивКлючейКонтрагентов.Добавить(КлючКонтрагента);
	        //Шихалиев Т.Р. 21.05.2026--
	    КонецЕсли; 
	    
	    Если НЕ ЗначениеЗаполнено(СтрокаЗапроса.Договор) И ЗначениеЗаполнено(СтрокаЗапроса.Контрагент) Тогда
	        ПоискДоговора = СоздатьСправочникДоговоров(СтрокаЗапроса.Контрагент, СтрокаЗапроса.Организация, СтрокаЗапроса.ДоговорНаименование);
	        СтрокаЗапроса.Договор = ПоискДоговора.Договор;
	    КонецЕсли;        
	    
	    ЗаполнитьЗначенияСвойств(СтруктураКонтрагент, СтрокаЗапроса);
	    МассивКонтрагентов.Добавить(ПодготовитьСтруктуруКВыгрузке(СтруктураКонтрагент));
	    
	КонецЦикла;

	Результат.Вставить("ТаблицаКонтрагентов", 	ТаблицаКонтрагентов);
	Результат.Вставить("МассивКонтрагентов", 	МассивКонтрагентов);
	Результат.Вставить("РезультатПоиска", 		РезультатПоиска);

	Возврат Результат;
	
КонецФункции

Функция НовыйПоискКонтрагентовИДоговоров(НаименованиеКонтрагента, КодВодителя, ТаблицаКонтрагентов)
    Результат = Новый Структура("Контрагент, Договор");
    
	//Шихалиев Т.Р. 22.05.2026++
	НаименованиеКонтрагента = НормализоватьСтрокуОбмена(НаименованиеКонтрагента);
	КодВодителя = НормализоватьСтрокуОбмена(КодВодителя);
	//Шихалиев Т.Р. 22.05.2026--
	
	Если ЗначениеЗаполнено(КодВодителя) И КодВодителя <> "000000000" И ЗначениеЗаполнено(НаименованиеКонтрагента) Тогда
		СтруктураТочногоПоиска = Новый Структура("КонтрагентНаименование, КодВодителя", НаименованиеКонтрагента, КодВодителя);
		НайденныеСтроки = ТаблицаКонтрагентов.НайтиСтроки(СтруктураТочногоПоиска);
		
		Если НайденныеСтроки.Количество() > 0 Тогда 
			ЗаполнитьЗначенияСвойств(Результат, НайденныеСтроки[0]);
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	//Шихалиев Т.Р. 22.05.2026++
	Если ЗначениеЗаполнено(КодВодителя) И КодВодителя <> "000000000" Тогда
		СтруктураПоискаПоКоду = Новый Структура("КодВодителя", КодВодителя);
		НайденныеСтроки = ТаблицаКонтрагентов.НайтиСтроки(СтруктураПоискаПоКоду);
		
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			Если ЗначениеЗаполнено(НайденнаяСтрока.Контрагент)
				И ЗначениеЗаполнено(НайденнаяСтрока.Договор) Тогда
				ЗаполнитьЗначенияСвойств(Результат, НайденнаяСтрока);
				Возврат Результат;
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			Если ЗначениеЗаполнено(НайденнаяСтрока.Контрагент) Тогда
				ЗаполнитьЗначенияСвойств(Результат, НайденнаяСтрока);
				Возврат Результат;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	//Шихалиев Т.Р. 22.05.2026--
    
        Если ЗначениеЗаполнено(НаименованиеКонтрагента) Тогда
        СтруктураПоискаПоИмени = Новый Структура("КонтрагентНаименование", НаименованиеКонтрагента);
        НайденныеСтроки = ТаблицаКонтрагентов.НайтиСтроки(СтруктураПоискаПоИмени);
        
        Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
            Если ЗначениеЗаполнено(НайденнаяСтрока.Контрагент) Тогда
                ЗаполнитьЗначенияСвойств(Результат, НайденнаяСтрока);
                Возврат Результат;
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    
    Возврат Результат;
КонецФункции

Функция ОбновитьКодВодителя(Контрагент, КодВодителя)
	
	Попытка
		
		Если НЕ ЗначениеЗаполнено(Контрагент) ИЛИ НЕ ЗначениеЗаполнено(КодВодителя) Тогда
			Возврат Новый Структура("Статус, Сообщение", Ложь, "Не заполнен контрагент или код водителя");
		КонецЕсли;
		
		// Ищем ссылку на свойство "КодВодителя"
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Свойство.Ссылка КАК Свойство
			|ИЗ
			|	ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК Свойство
			|ГДЕ
			|	Свойство.Наименование = ""КодВодителя""
			|	И Свойство.ПометкаУдаления = ЛОЖЬ";
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
			Возврат Новый Структура("Статус, Сообщение", Ложь, "Свойство 'КодВодителя' не найдено");
		КонецЕсли;
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Свойство = Выборка.Свойство; // ← это ссылка на ПланВидовХарактеристик
		
		// Записываем в регистр ДополнительныеСведения
		МенеджерЗаписи = РегистрыСведений.ДополнительныеСведения.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Объект = Контрагент;      // ← ссылка на контрагента
		МенеджерЗаписи.Свойство = Свойство;      // ← ссылка на свойство КодВодителя
		МенеджерЗаписи.Прочитать();
		
		МенеджерЗаписи.Объект = Контрагент;
		МенеджерЗаписи.Свойство = Свойство;
		МенеджерЗаписи.Значение = КодВодителя;   // ← сам код (строка)
		МенеджерЗаписи.Записать(Истина);
		
		Возврат Новый Структура("Статус, Сообщение", Истина, "Код водителя успешно записан");
		
	Исключение
		Возврат Новый Структура("Статус, Сообщение", Ложь, "Ошибка записи кода: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецФункции


