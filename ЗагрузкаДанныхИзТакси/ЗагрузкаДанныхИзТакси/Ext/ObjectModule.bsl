Функция ПереименоватьПрофильДоступа(СтруктураПараметров)

	Если НЕ СтруктураПараметров.Свойство("СтароеИмяПрофиля")
		ИЛИ НЕ ЗначениеЗаполнено(СтруктураПараметров.СтароеИмяПрофиля) Тогда
		Возврат ПолучитьРезультатСОшибкой("Не передан параметр СтароеИмяПрофиля");
	КонецЕсли;

	Если НЕ СтруктураПараметров.Свойство("НовоеИмяПрофиля")
		ИЛИ НЕ ЗначениеЗаполнено(СтруктураПараметров.НовоеИмяПрофиля) Тогда
		Возврат ПолучитьРезультатСОшибкой("Не передан параметр НовоеИмяПрофиля");
	КонецЕсли;

	СтароеИмяПрофиля = СокрЛП(СтруктураПараметров.СтароеИмяПрофиля);
	НовоеИмяПрофиля = СокрЛП(СтруктураПараметров.НовоеИмяПрофиля);
	Если СтароеИмяПрофиля = НовоеИмяПрофиля Тогда
		Возврат Новый Структура("Ошибка", Ложь);
	КонецЕсли;

	СсылкаПрофиля = Справочники.ПрофилиГруппДоступа.НайтиПоНаименованию(СтароеИмяПрофиля, Истина);
	Если НЕ ЗначениеЗаполнено(СсылкаПрофиля) Тогда
		Возврат ПолучитьРезультатСОшибкой("Профиль не найден: " + СтароеИмяПрофиля);
	КонецЕсли;

	Если ЗначениеЗаполнено(СсылкаПрофиля.ИдентификаторПоставляемыхДанных) Тогда
		Возврат ПолучитьРезультатСОшибкой("Невозможно переименовать предопределенный профиль");
	КонецЕсли;

	ПрофильСНовымИменем = Справочники.ПрофилиГруппДоступа.НайтиПоНаименованию(НовоеИмяПрофиля, Истина);
	Если ЗначениеЗаполнено(ПрофильСНовымИменем) Тогда
		Возврат ПолучитьРезультатСОшибкой("Профиль с таким именем уже существует: " + НовоеИмяПрофиля);
	КонецЕсли;

	ОбъектПрофиля = СсылкаПрофиля.ПолучитьОбъект();
	ОбъектПрофиля.Наименование = НовоеИмяПрофиля;
	ОбъектПрофиля.Записать();

	Возврат Новый Структура("Ошибка", Ложь);

