		ДокументОбъект.Номенклатура 	= Справочники.Номенклатура.НайтиПоНаименованию("Аренда автомобилей (сут)", Истина);
	КонецЕсли;	
    ДокументОбъект.Комментарий 		= "Перенос из такси новый";
    ДокументОбъект.СтавкаНДС 		= Перечисления.СтавкиНДС.БезНДС ;
    ДокументОбъект.СчетДоходов 		= ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.01.1")  ;
    ДокументОбъект.Субконто 		= Справочники.НоменклатурныеГруппы.НайтиПоНаименованию("Аренда автомобиля", Истина);	
	
	
	
	//	20240131_Поздняков	(
	ОбщаяСН	=	Ложь;
	ОбщаяСН	=	ПолучитьОбщуюСН(ДокументОбъект.Организация);
	Если	ОбщаяСН	Тогда
		ДокументОбъект.СтавкаНДС					=	Перечисления.СтавкиНДС.НДС22;
		ДокументОбъект.СуммаВключаетНДС				=	Истина;	
		ДокументОбъект.СчетУчетаНДСПоРеализации		=	ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.03");
		ДокументОбъект.СчетРасходов					=	ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.02.1");
	КонецЕсли;
