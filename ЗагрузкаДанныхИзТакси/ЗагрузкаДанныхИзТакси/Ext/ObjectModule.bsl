#region ОтчетПоСчетам68_69
Функция ПолучитьОборотыСчета68_69(СтруктураОтбора)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ПОДСТРОКА(ХозрасчетныйОбороты.Счет.Код, 1, 5) = ""68.01""
		|			ТОГДА ""68.01 НДФЛ""
		|		КОГДА ПОДСТРОКА(ХозрасчетныйОбороты.Счет.Код, 1, 5) = ""68.02""
		|			ТОГДА ""68.02 НДС""
		|		КОГДА ПОДСТРОКА(ХозрасчетныйОбороты.Счет.Код, 1, 5) = ""68.04""
		|			ТОГДА ""68.04 Налог на прибыль""
		|		КОГДА ПОДСТРОКА(ХозрасчетныйОбороты.Счет.Код, 1, 5) = ""68.07""
		|			ТОГДА ""68.07 Транспортный налог""
		|		КОГДА ПОДСТРОКА(ХозрасчетныйОбороты.Счет.Код, 1, 5) = ""68.12""
		|			ТОГДА ""68.12 УСН""
		|		КОГДА ПОДСТРОКА(ХозрасчетныйОбороты.Счет.Код, 1, 2) = ""69""
		|			ТОГДА ХозрасчетныйОбороты.Счет.Код
		|	КОНЕЦ КАК Счет,
		|	ХозрасчетныйОбороты.Счет.Код КАК СчетКод,
		|	ХозрасчетныйОбороты.Субконто1 КАК Субконто1,
		|	ХозрасчетныйОбороты.КорСчет.Код КАК КорСчет,
		|	ХозрасчетныйОбороты.СуммаОборот КАК СуммаОборот,
		|	ХозрасчетныйОбороты.КорСубконто1 КАК КорСубконто1,
		|	ХозрасчетныйОбороты.Период КАК Период
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.Обороты(&НачалоПериода, &ОкончаниеПериода, Месяц, Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.НДФЛ_НалоговогоАгента), ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.НДС), ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.НалогНаПрибыль), ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ТранспортныйНалог), ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ЕНприУСН), ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетыПоСоциальномуСтрахованию)), , Организация = &Организация, , ) КАК ХозрасчетныйОбороты";
	
	Если СтруктураОтбора.ВидОтчета = "ПоОрганизациям" Тогда 
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Месяц", "Период");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ХозрасчетныйОбороты.Период", "&НачалоПериода");
	КонецЕсли; 
		
	Запрос.УстановитьПараметр("Организация", 		СтруктураОтбора.Организация);
	Запрос.УстановитьПараметр("НачалоПериода", 		СтруктураОтбора.ДатаНачала); 
	Запрос.УстановитьПараметр("ОкончаниеПериода", 	КонецДня(СтруктураОтбора.ДатаОкончания));	

	//для Госта пропишем отдельно, потому что нужны сводные данные по 2-м организациям из одной базы
	Если СтруктураОтбора.ИНН = "7724683227" Тогда
		Организация2 = Справочники.Организации.НайтиПоРеквизиту("ИНН", "7715808399");
		Запрос.УстановитьПараметр("Организация2", 		Организация2);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Организация = &Организация", "Организация = &Организация ИЛИ Организация = &Организация2");
	КонецЕсли;	
	
	РезультатЗапроса = Запрос.Выполнить();
	
