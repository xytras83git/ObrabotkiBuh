Функция ПолучитьМассивОперации(СтруктураОтбора)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОперацияБух.Номер КАК Номер,
		|	ОперацияБух.Дата КАК Дата,
		|	ЕСТЬNULL(ХозрасчетныйДвиженияССубконто.СчетДт.Код, """") КАК СчетДт,
		|	ЕСТЬNULL(ХозрасчетныйДвиженияССубконто.СчетКт.Код, """") КАК СчетКт,
		|	ЕСТЬNULL(Контрагенты.Наименование, """") КАК КонтрагентКт,
		|	ЕСТЬNULL(КонтрагентыОбщий.Наименование, """") КАК КонтрагентДт,
		|	ЕСТЬNULL(ХозрасчетныйДвиженияССубконто.Содержание, """") КАК Содержание,
		|	ЕСТЬNULL(ХозрасчетныйДвиженияССубконто.Сумма, """") КАК Сумма,
		|	ЕСТЬNULL(КонтрагентыОбщий.Наименование, """") КАК ВодительНаименование,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(КодВодителяКонтрагентаДт.Значение, """") <> """"
		|			ТОГДА КодВодителяКонтрагентаДт.Значение
		|		ИНАЧЕ ЕСТЬNULL(КодВодителяКонтрагентаКт.Значение, """")
		|	КОНЕЦ КАК КодВодителя
		|ПОМЕСТИТЬ ВТ_СтрокиОпераций
		|ИЗ
		|	Документ.ОперацияБух КАК ОперацияБух
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто(, , , , ) КАК ХозрасчетныйДвиженияССубконто
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
		|			ПО ХозрасчетныйДвиженияССубконто.СубконтоКт1 = Контрагенты.Ссылка
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК КонтрагентыОбщий
		|			ПО ХозрасчетныйДвиженияССубконто.СубконтоДт1 = КонтрагентыОбщий.Ссылка
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК КодВодителяКонтрагентаКт
		|			ПО ХозрасчетныйДвиженияССубконто.СубконтоКт1 = КодВодителяКонтрагентаКт.Объект
		|				И (КодВодителяКонтрагентаКт.Свойство.Наименование = ""КодВодителя"")
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК КодВодителяКонтрагентаДт
		|			ПО ХозрасчетныйДвиженияССубконто.СубконтоДт1 = КодВодителяКонтрагентаДт.Объект
		|				И (КодВодителяКонтрагентаДт.Свойство.Наименование = ""КодВодителя"")
		|		ПО ОперацияБух.Ссылка = ХозрасчетныйДвиженияССубконто.Регистратор
		|ГДЕ
		|	ОперацияБух.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&ДатаНачала, МЕСЯЦ) И КОНЕЦПЕРИОДА(&ДатаОкончания, МЕСЯЦ)
		|	И ОперацияБух.Содержание ПОДОБНО ""%Перенос данных из такси%""
		|	И ОперацияБух.ПометкаУдаления = ЛОЖЬ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МИНИМУМ(ВТ_СтрокиОпераций.Номер) КАК Номер,
		|	ВТ_СтрокиОпераций.Дата КАК Дата,
		|	ВТ_СтрокиОпераций.СчетДт КАК СчетДт,
		|	ВТ_СтрокиОпераций.СчетКт КАК СчетКт,
		|	ВТ_СтрокиОпераций.КонтрагентКт КАК КонтрагентКт,
		|	ВТ_СтрокиОпераций.КонтрагентДт КАК КонтрагентДт,
		|	ВТ_СтрокиОпераций.Содержание КАК Содержание,
		|	ВТ_СтрокиОпераций.Сумма КАК Сумма,
		|	ВТ_СтрокиОпераций.ВодительНаименование КАК ВодительНаименование,
		|	ВТ_СтрокиОпераций.КодВодителя КАК КодВодителя
		|ИЗ
		|	ВТ_СтрокиОпераций КАК ВТ_СтрокиОпераций
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_СтрокиОпераций.Дата,
		|	ВТ_СтрокиОпераций.СчетДт,
		|	ВТ_СтрокиОпераций.СчетКт,
		|	ВТ_СтрокиОпераций.КонтрагентКт,
		|	ВТ_СтрокиОпераций.КонтрагентДт,
		|	ВТ_СтрокиОпераций.Содержание,
		|	ВТ_СтрокиОпераций.Сумма,
		|	ВТ_СтрокиОпераций.ВодительНаименование,
		|	ВТ_СтрокиОпераций.КодВодителя";
	
	Запрос.УстановитьПараметр("ДатаНачала", 	СтруктураОтбора.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", 	СтруктураОтбора.ДатаОкончания);
	
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаДокументов = РезультатЗапроса.Выгрузить();
	МассивДокументов = ПреобразоватьТаблицуВМассивСтрокДляВыгрузки(ТаблицаДокументов, Истина);	
	
	Возврат МассивДокументов;
	
КонецФункции

Функция ПолучитьДокументыАрендыЗаПериод(СтруктураПараметров)
	
	Если СтруктураПараметров.Свойство("ДатаНачала") Тогда
			
		ДатаНачала 		= ДатаИзСтроки(СтруктураПараметров.ДатаНачала);
		ДатаОкончания 	= ДатаИзСтроки(СтруктураПараметров.ДатаОкончания);
		СтруктураОтбора = Новый Структура("ДатаНачала, ДатаОкончания", ДатаНачала, ДатаОкончания);
		
		МассивРКО 		= ПолучитьМассивРКО(СтруктураОтбора);
		МассивПКО 		= ПолучитьМассивПКО(СтруктураОтбора);
		МассивКО 		= ПолучитьМассивКО(СтруктураОтбора);
		МассивОперации 	= ПолучитьМассивОперации(СтруктураОтбора);
		
		СтруктураОтвета = Новый Структура();
		СтруктураОтвета.Вставить("Статус"					, "Истина"); 
		СтруктураОтвета.Вставить("ДатаЗапретаИзменения"		, Строка(ПолучитьДатуЗапретаИзменения()));
		СтруктураОтвета.Вставить("МассивКО"					, МассивКО);
		СтруктураОтвета.Вставить("МассивРКО"				, МассивРКО);
		СтруктураОтвета.Вставить("МассивПКО"				, МассивПКО);
		СтруктураОтвета.Вставить("МассивОперации"			, МассивОперации);
			
		Возврат СтруктураОтвета;
		
	КонецЕсли;
	
	СтруктураОтвета = Новый Структура();
	СтруктураОтвета.Вставить("ТестовыйПараметр", "ДокументыЭквайринг2");
	Возврат СтруктураОтвета;
	
КонецФункции

Функция ПоискДокументаКассовыйОрдер(СтруктураДокумент, ДатаДокумента, ТипДокумента, КонтрагентПоиска = Неопределено)
	
	//Шихалиев Т.Р. 21.05.2026++
	Если КонтрагентПоиска = Неопределено Тогда
		КонтрагентПоиска = Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;
	//Шихалиев Т.Р. 21.05.2026--
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Организации.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТ_Организации
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	Организации.ПометкаУдаления = ЛОЖЬ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПриходныйКассовыйОрдер.Номер КАК Номер,
		|	ПриходныйКассовыйОрдер.Дата КАК Дата,
		|	ПриходныйКассовыйОрдер.ВидОперации КАК ВидОперации,
		|	ПриходныйКассовыйОрдер.СубконтоКт1.Наименование КАК КонтрагентНаименование,
		|	ПриходныйКассовыйОрдер.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТ_ДокументыОтобранные
		|ИЗ
		|	Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
		|ГДЕ
		|	ПриходныйКассовыйОрдер.Организация В
		|			(ВЫБРАТЬ ВТ_Организации.Ссылка ИЗ ВТ_Организации КАК ВТ_Организации)
		|	И ПриходныйКассовыйОрдер.Дата = &ДатаДокумента
		|	И (&КонтрагентПоискаЗаполнен = ИСТИНА
		|			И ПриходныйКассовыйОрдер.СубконтоКт1 = &КонтрагентПоиска
		|		ИЛИ &КонтрагентПоискаЗаполнен = ЛОЖЬ
		|			И ПриходныйКассовыйОрдер.СубконтоКт1.Наименование = &ВодительНаименование)
		|	И ПриходныйКассовыйОрдер.ПометкаУдаления = ЛОЖЬ
		|	И ПриходныйКассовыйОрдер.СуммаДокумента = &СуммаДокумента
		|	И ПриходныйКассовыйОрдер.СтатьяДвиженияДенежныхСредств = &СтатьяДвижения
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	РасходныйКассовыйОрдер.Номер,
		|	РасходныйКассовыйОрдер.Дата,
		|	РасходныйКассовыйОрдер.ВидОперации,
		|	РасходныйКассовыйОрдер.Выдать,
		|	РасходныйКассовыйОрдер.Ссылка
		|ИЗ
		|	Документ.РасходныйКассовыйОрдер КАК РасходныйКассовыйОрдер
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РасходныйКассовыйОрдер.РасшифровкаПлатежа КАК РасходныйКассовыйОрдерРасшифровкаПлатежа
		|		ПО РасходныйКассовыйОрдер.Ссылка = РасходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка
		|ГДЕ
		|	РасходныйКассовыйОрдер.Организация В
		|			(ВЫБРАТЬ ВТ_Организации.Ссылка ИЗ ВТ_Организации КАК ВТ_Организации)
		|	И РасходныйКассовыйОрдер.Дата = &ДатаДокумента
		|	И (&КонтрагентПоискаЗаполнен = ИСТИНА
		|			И РасходныйКассовыйОрдер.СубконтоДт1 = &КонтрагентПоиска
		|		ИЛИ &КонтрагентПоискаЗаполнен = ЛОЖЬ
		|			И РасходныйКассовыйОрдер.Выдать = &ВодительНаименование
		|			И РасходныйКассовыйОрдер.СубконтоДт1.Наименование = &Контрагент)
		|	И РасходныйКассовыйОрдер.ПометкаУдаления = ЛОЖЬ
		|	И РасходныйКассовыйОрдер.СуммаДокумента = &СуммаДокумента
		|	И ВЫБОР
		|			КОГДА РасходныйКассовыйОрдер.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРКО.ВозвратПокупателю)
		|				ТОГДА РасходныйКассовыйОрдерРасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств
		|			ИНАЧЕ РасходныйКассовыйОрдер.СтатьяДвиженияДенежныхСредств
		|		КОНЕЦ = &СтатьяДвижения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ДокументыОтобранные.Ссылка КАК Ссылка
		|ИЗ
		|	ВТ_ДокументыОтобранные КАК ВТ_ДокументыОтобранные";
		
	Запрос.УстановитьПараметр("ДатаДокумента", 			ДатаДокумента);
	Запрос.УстановитьПараметр("Контрагент", 			СтруктураДокумент.КонтрагентКО);
	Запрос.УстановитьПараметр("ВодительНаименование", 	СтруктураДокумент.ВодительНаименование);
	Запрос.УстановитьПараметр("КонтрагентПоиска", 		КонтрагентПоиска);
	Запрос.УстановитьПараметр("КонтрагентПоискаЗаполнен", ЗначениеЗаполнено(КонтрагентПоиска));
	Запрос.УстановитьПараметр("СуммаДокумента", 		СтруктураДокумент.Сумма);
	Запрос.УстановитьПараметр("СтатьяДвижения", 		СоздатьСтатьюДДС(СтруктураДокумент.СтатьяДвиженияДенежныхСредств));
	Запрос.УстановитьПараметр("СтатьяДвиженияНаименование", СтруктураДокумент.СтатьяДвиженияДенежныхСредств);
			
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Документы.ПриходныйКассовыйОрдер.ПустаяСсылка();
	
КонецФункции

Функция СоздатьДокументыАренды(СтруктураПараметров)
	
	Если СтруктураПараметров.Свойство("МассивДокументов") Тогда
		
		СтруктураПоискаКонтрагентов = ОбработатьКонтрагентовИДоговоры(СтруктураПараметров);	
		ТаблицаКонтрагентов = СтруктураПоискаКонтрагентов.ТаблицаКонтрагентов;	
				
		СтруктураОтвета = Новый Структура();
		СтруктураОтвета.Вставить("МассивКонтрагентов", 				ПреобразоватьТаблицуВМассивСтрокДляВыгрузки(ТаблицаКонтрагентов, Истина));
		СтруктураОтвета.Вставить("РезультатПоискаКонтрагентов", 	СтруктураПоискаКонтрагентов.РезультатПоиска);
		
		РезультатСоздания = Новый Структура();
		МассивОтветов = Новый Массив;		
		МассивСтрокОперации = Новый Массив;
		
		Для каждого ЭлементМассива из СтруктураПараметров.МассивДокументов Цикл			
			Если ЭлементМассива.ТипДокумента = "КассовыйОрдер" Тогда
				СтруктураДокумент = СоздатьДокументКассовыйОрдер(ЭлементМассива, ТаблицаКонтрагентов);
				ДополнитьРезультатЛогированияОперации(СтруктураДокумент, "Аренда");
				МассивОтветов.Добавить(СтруктураДокумент);
			ИначеЕсли ЭлементМассива.ТипДокумента = "Операция" Тогда
				МассивСтрокОперации.Добавить(ЭлементМассива);
			КонецЕсли;
		КонецЦикла;
		
		Если МассивСтрокОперации.Количество() > 0 Тогда				
			СтруктураОперация = СоздатьДокументОперация(МассивСтрокОперации, ТаблицаКонтрагентов); 
			ДополнитьРезультатЛогированияОперации(СтруктураОперация, "Аренда");
			СтруктураОтвета.Вставить("ДокументОперация", СтруктураОперация);
		КонецЕсли;
		
		РезультатСоздания.Вставить("МассивОтветов", МассивОтветов);
		СтруктураОтвета.Вставить("РезультатСоздания", РезультатСоздания);
		
	Иначе
		СтруктураОтвета = Новый Структура();
		СтруктураОтвета.Вставить("ТестовыйПараметр", "ДокументыЭквайринг2");
	КонецЕсли;
	
	Возврат СтруктураОтвета;
	
КонецФункции

Функция СоздатьДокументКассовыйОрдер(СтруктураДокумент, ТаблицаКонтрагентов)

	РезультатСозданияДокумента = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(СтруктураДокумент);
	
	ДатаДокумента = ДатаИзСтроки(СтруктураДокумент.ДатаДокумента);
	
	Если НЕ ТипЗнч(ДатаДокумента) = Тип("Дата") Тогда
		РезультатСозданияДокумента.Вставить("Статус", "Ложь");
		РезультатСозданияДокумента.Вставить("Сообщение", "Не удалось распознать дату документа!");
		Возврат РезультатСозданияДокумента;
	ИначеЕсли Год(ДатаДокумента) < 2020 Тогда
		РезультатСозданияДокумента.Вставить("Статус", "Ложь");
		РезультатСозданияДокумента.Вставить("Сообщение", "Некорректная дата документа!");
		Возврат РезультатСозданияДокумента;
	КонецЕсли;
	
	НРЕГОперация = НРЕГ(СтруктураДокумент.ВыгружаемаяОперация);
	
	//Шихалиев Т.Р. 21.05.2026++
	КодВодителя = "";
	Если СтруктураДокумент.Свойство("КодВодителя") Тогда
		КодВодителя = СтруктураДокумент.КодВодителя;
	КонецЕсли;
	СтруктураКонтрагент = НовыйПоискКонтрагентовИДоговоров(СтруктураДокумент.КонтрагентКО, КодВодителя, ТаблицаКонтрагентов);
	//Шихалиев Т.Р. 21.05.2026--
	
	Если Не ЗначениеЗаполнено(СтруктураКонтрагент.Контрагент) Тогда
		РезультатСозданияДокумента.Вставить("Статус", "Ложь");
		РезультатСозданияДокумента.Вставить("Сообщение", "Не удалось получить контрагента!");
		Возврат РезультатСозданияДокумента;
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(СтруктураКонтрагент.Договор) Тогда 
		РезультатСозданияДокумента.Вставить("Статус", "Ложь");
		РезультатСозданияДокумента.Вставить("Сообщение", "Не удалось получить договор контрагента!");
		Возврат РезультатСозданияДокумента;
	КонецЕсли;
	
	СтатьяДДС = СоздатьСтатьюДДС(СтруктураДокумент.СтатьяДвиженияДенежныхСредств);

	Если Не ЗначениеЗаполнено(СтатьяДДС) Тогда 
		РезультатСозданияДокумента.Вставить("Статус", "Ложь");
		РезультатСозданияДокумента.Вставить("Сообщение", "Не удалось получить статью ДДС!");
		Возврат РезультатСозданияДокумента;
	КонецЕсли;	
	
	Если Найти(НРЕГОперация, "рко") > 0 Тогда
		ТипДокумента = "РасходныйКассовыйОрдер";
		РеквизитКонтрагента = "СубконтоДт1";
		РеквизитДоговора 	= "СубконтоДт2";
	ИначеЕсли Найти(НРЕГОперация, "пко") > 0 Тогда
		ТипДокумента = "ПриходныйКассовыйОрдер";
		РеквизитКонтрагента = "СубконтоКт1";
		РеквизитДоговора 	= "СубконтоКт2";
	КонецЕсли;
	
	ДокументСсылка = ПоискДокументаКассовыйОрдер(СтруктураДокумент, ДатаДокумента, ТипДокумента, СтруктураКонтрагент.Контрагент);
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		ДокументОбъект = Документы[ТипДокумента].СоздатьДокумент();
		РезультатСозданияДокумента.Вставить("ДокументНайден", "Ложь");
		ДокументБылНайден = Ложь;
	Иначе
		ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
		РезультатСозданияДокумента.Вставить("ДокументНайден", "Истина");
		ДокументБылНайден = Истина;
	КонецЕсли;
	
	ДокументОбъект.Дата 			= ДатаДокумента;
    ДокументОбъект.ВалютаДокумента 	= Константы.ВалютаРегламентированногоУчета.Получить();

	Если Найти(НРЕГОперация, "ркоаренда") > 0 Тогда 
	    ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийРКО.ВозвратПокупателю;
	ИначеЕсли Найти(НРЕГОперация, "рко") > 0 Тогда
		ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийРКО.ПрочийРасход;	
	ИначеЕсли Найти(НРЕГОперация, "пко") > 0 Тогда
    	ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийПКО.ПрочийПриход;
	КонецЕсли;
	
	ТекущаяОрганизация = Справочники.Организации.Выбрать();
	ТекущаяОрганизация.Следующий();
	ДокументОбъект.Организация		= ТекущаяОрганизация.Ссылка;
	
    ДокументОбъект.СчетКасса 		= ПланыСчетов.Хозрасчетный.НайтиПоКоду("50.01");
    ДокументОбъект.СуммаДокумента 	= СтруктураДокумент.Сумма;
	ДокументОбъект.СчетУчетаРасчетовСКонтрагентом = ПланыСчетов.Хозрасчетный.НайтиПоКоду(СтруктураДокумент.СчетУчета); 

	ДокументОбъект[РеквизитКонтрагента] = СтруктураКонтрагент.Контрагент;
	ДокументОбъект[РеквизитДоговора]	= СтруктураКонтрагент.Договор;
	ДокументОбъект.Контрагент			= ДокументОбъект[РеквизитКонтрагента];
	ДокументОбъект.СтатьяДвиженияДенежныхСредств = СтатьяДДС;
	ДокументОбъект.Комментарий = "Перенос данных из такси новый";
	
	Если ТипДокумента = "РасходныйКассовыйОрдер" Тогда
		ДокументОбъект.Выдать = СтруктураДокумент.ВодительНаименование;
	ИначеЕсли ТипДокумента = "ПриходныйКассовыйОрдер" 
		И СтруктураДокумент.СтатьяДвиженияДенежныхСредств = "Внешние" Тогда
		ДокументОбъект.ПринятоОт = СтруктураДокумент.ВодительНаименование;
	КонецЕсли;

	Если ТипДокумента = "РасходныйКассовыйОрдер"
		И НЕ Найти(НРЕГОперация, "ркофраншиза") > 0 Тогда
    	ДокументОбъект.ДоходыЕНВД_УСН = Истина;
	Иначе
		ДокументОбъект.ДоходыЕНВД_УСН = Ложь;
	КонецЕсли;

    ДокументОбъект.Содержание_УСН = СтруктураДокумент.СодержаниеКУДР;

	Если ТипДокумента = "ПриходныйКассовыйОрдер" Тогда
		Если Найти(НРЕГОперация, "пкоаренда") > 0 Тогда 
	    	ДокументОбъект.Графа4_УСН = СтруктураДокумент.Сумма;
	    	ДокументОбъект.Графа5_УСН = СтруктураДокумент.Сумма;
		Иначе
	    	ДокументОбъект.Графа4_УСН = 0;
	    	ДокументОбъект.Графа5_УСН = 0;
		КонецЕсли;  
	ИначеЕсли ТипДокумента = "РасходныйКассовыйОрдер" Тогда 
		Если Найти(НРЕГОперация, "ркоаренда") > 0 Тогда 
			ДокументОбъект.Графа7_УСН = СтруктураДокумент.Сумма;
		Иначе
			ДокументОбъект.Графа7_УСН = 0;	
		КонецЕсли;
	КонецЕсли;
	
	Если Найти(НРЕГОперация, "ркоаренда") > 0 Тогда
		
		ДокументОбъект.РасшифровкаПлатежа.Очистить();
		стр = ДокументОбъект.РасшифровкаПлатежа.добавить();
	    стр.ДоговорКонтрагента 				= ДокументОбъект[РеквизитДоговора];
	    стр.СпособПогашенияЗадолженности 	= Перечисления.СпособыПогашенияЗадолженности.Автоматически;
	    стр.СуммаПлатежа 					= СтруктураДокумент.Сумма;
	    стр.КурсВзаиморасчетов 				= 1;
	    стр.СуммаВзаиморасчетов 			= СтруктураДокумент.Сумма;
	    стр.СчетУчетаРасчетовСКонтрагентом 	= ДокументОбъект.СчетУчетаРасчетовСКонтрагентом;
	    стр.СчетУчетаРасчетовПоАвансам		= ДокументОбъект.СчетУчетаРасчетовСКонтрагентом;
	    стр.КратностьВзаиморасчетов			= 1;
	    стр.РасходыУСН						= СтруктураДокумент.Сумма;
		стр.СтатьяДвиженияДенежныхСредств   = СтатьяДДС;
		
	КонецЕсли;
				
	Попытка 
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		РезультатСозданияДокумента.Вставить("Статус", "Истина");
	Исключение
	    РезультатСозданияДокумента.Вставить("Статус", "Ложь");
		РезультатСозданияДокумента.Вставить("ОписаниеОшибки", ОписаниеОшибки());
	КонецПопытки;
	
	ДополнитьРезультатЛогированияДокумента(РезультатСозданияДокумента, ДокументОбъект, "Аренда", ДокументБылНайден);
	
	Возврат РезультатСозданияДокумента;
				
КонецФункции

Функция ПоискДокументаОперация(ДатаДокумента)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Организации.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТ_Организации
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	Организации.ПометкаУдаления = ЛОЖЬ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОперацияБух.Номер КАК Номер,
		|	ОперацияБух.Дата КАК Дата,
		|	ОперацияБух.Ссылка КАК Ссылка,
		|	ОперацияБух.Содержание КАК Содержание
		|ПОМЕСТИТЬ ВТ_ДокументыОтобранные
		|ИЗ
		|	Документ.ОперацияБух КАК ОперацияБух
		|ГДЕ
		|	ОперацияБух.Организация В
		|			(ВЫБРАТЬ ВТ_Организации.Ссылка ИЗ ВТ_Организации КАК ВТ_Организации)
		|	И ОперацияБух.Дата = &ДатаДокумента
		|	И ОперацияБух.ПометкаУдаления = ЛОЖЬ
		|	И (ОперацияБух.Содержание = ""Перенос данных из такси"" ИЛИ ОперацияБух.Содержание = ""Перенос данных из такси новый"")
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ДокументыОтобранные.Ссылка КАК Ссылка
		|ИЗ
		|	ВТ_ДокументыОтобранные КАК ВТ_ДокументыОтобранные";
	
	Запрос.УстановитьПараметр("ДатаДокумента", ДатаДокумента);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Документы.ОперацияБух.ПустаяСсылка();
	
КонецФункции

Функция СоздатьДокументОперация(МассивСтрокОперации, ТаблицаКонтрагентов)
	
	Результат = Новый Структура(); 
	Результат.Вставить("МассивСтрокОперации", МассивСтрокОперации); 
	
	Если МассивСтрокОперации.Количество() = 0 Тогда
		 Возврат Новый Структура("Статус, Сообщение", "Ложь", "Нет строк для загрузки");
	КонецЕсли;  
	
	СтруктураСтроки = МассивСтрокОперации[0];
	ДатаДокумента = ДатаИзСтроки(СтруктураСтроки.ДатаДокумента);
	
	Если НЕ ТипЗнч(ДатаДокумента) = Тип("Дата") Тогда
		Возврат Новый Структура("Статус, Сообщение", "Ложь", "Не удалось распознать дату документа!");
	ИначеЕсли Год(ДатаДокумента) < 2020 Тогда
		Возврат Новый Структура("Статус, Сообщение", "Ложь", "Некорректная дата документа!");
	КонецЕсли;
	
	ДокументСсылка = ПоискДокументаОперация(ДатаДокумента);
	
	ТекущаяОрганизация = Справочники.Организации.Выбрать();
	ТекущаяОрганизация.Следующий();	
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		ДокументОбъект = Документы.ОперацияБух.СоздатьДокумент();
		ДокументОбъект.Дата = ДатаДокумента;
		ДокументОбъект.Содержание = "Перенос данных из такси новый";
		ДокументОбъект.Организация = ТекущаяОрганизация.Ссылка; 
		ДокументОбъект.СпособЗаполнения = "Вручную";  
		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись); 
		ДокументСсылка = ДокументОбъект.Ссылка;
		ДокументБылНайден = Ложь;
	Иначе
		ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
		ДокументБылНайден = Истина;
	КонецЕсли;
	
	Проводки = РегистрыБухгалтерии.Хозрасчетный.СоздатьНаборЗаписей();
	КУДР 	 = РегистрыНакопления.КнигаУчетаДоходовИРасходов.СоздатьНаборЗаписей();

	Проводки.Отбор.Регистратор.Установить(ДокументСсылка);
	Проводки.Прочитать();
	ТаблицаПроводок = Проводки.Выгрузить();
		
	КУДР.Отбор.Регистратор.Установить(ДокументСсылка);
	КУДР.Прочитать();
	ТаблицаКУДР = КУДР.Выгрузить();
		
	ДобавленоСтрокКУДР = 0;
	ОбработанныеСтроки = Новый Массив;

	Для каждого СтрокаМассива из МассивСтрокОперации Цикл

		//Шихалиев Т.Р. 03.04.2026++ Пропуск строк с пустыми счетами
		Если НЕ ЗначениеЗаполнено(СтрокаМассива.СчетДт)
			ИЛИ НЕ ЗначениеЗаполнено(СтрокаМассива.СчетКт) Тогда
			Продолжить;
		КонецЕсли;
		//Шихалиев Т.Р. 03.04.2026--

		СтруктураСтроки = Новый Структура();
		
		СтруктураПоиска = Новый Структура();
		СтруктураПоиска.Вставить("Содержание", СтрокаМассива.Содержание);
		Если СтрокаМассива.СчетКт = "91.01" Тогда     
			СтруктураКонтрагентДт = НовыйПоискКонтрагентовИДоговоров(СтрокаМассива.КонтрагентДт, СтрокаМассива.КодВодителя, ТаблицаКонтрагентов);
			СтруктураПоиска.Вставить("СубконтоДт3", СтруктураКонтрагентДт.Контрагент);
			КонтрагентПоиска = СтруктураКонтрагентДт.Контрагент;
		Иначе
			СтруктураКонтрагентКт = НовыйПоискКонтрагентовИДоговоров(СтрокаМассива.КонтрагентКт, СтрокаМассива.КодВодителя, ТаблицаКонтрагентов);
			СтруктураПоиска.Вставить("СубконтоКт3", СтруктураКонтрагентКт.Контрагент);
			КонтрагентПоиска = СтруктураКонтрагентКт.Контрагент;
		КонецЕсли;
		
		НайденныеСтроки = ТаблицаПроводок.НайтиСтроки(СтруктураПоиска);
		СтруктураСтроки.Вставить("НайденныеСтрокиКоличество", НайденныеСтроки.Количество());
			
		Если НайденныеСтроки.Количество() = 0 Тогда

		    СтрокаПроводка = Проводки.Добавить();
			СтрокаПроводка.Активность	= Истина;
		    СтрокаПроводка.СчетДт		= ПланыСчетов.Хозрасчетный.НайтиПоКоду(СтрокаМассива.СчетДт);
		    СтрокаПроводка.СчетКт		= ПланыСчетов.Хозрасчетный.НайтиПоКоду(СтрокаМассива.СчетКт);
		    СтрокаПроводка.Сумма		= СтрокаМассива.Сумма;
		    СтрокаПроводка.Организация	= ТекущаяОрганизация.Ссылка;
		    СтрокаПроводка.Период		= ДатаДокумента; 
			
			СтруктураКонтрагентДт = НовыйПоискКонтрагентовИДоговоров(СтрокаМассива.КонтрагентДт, СтрокаМассива.КодВодителя, ТаблицаКонтрагентов);
			СтруктураСтроки.Вставить("СтруктураКонтрагентДтКонтрагент", Строка(СтруктураКонтрагентДт.Контрагент));
			СтруктураСтроки.Вставить("СтрокаМассиваКонтрагентДт", Строка(СтрокаМассива.КонтрагентДт));
			
	    	СтрокаПроводка.СубконтоДт.Контрагенты = СтруктураКонтрагентДт.Контрагент;
	    	СтрокаПроводка.СубконтоДт.Договоры	   = СтруктураКонтрагентДт.Договор;

			Если СтрокаМассива.СчетКт = "91.01" Тогда
				СтрокаПроводка.СубконтоКт.ПрочиеДоходыИРасходы = СоздатьПрочиеДоходыИРасходы(СтрокаМассива.СтатьяДвиженияДенежныхСредств);
			Иначе
				СтруктураКонтрагентКт = НовыйПоискКонтрагентовИДоговоров(СтрокаМассива.КонтрагентКт, СтрокаМассива.КодВодителя, ТаблицаКонтрагентов);
			    СтрокаПроводка.СубконтоКт.Контрагенты = СтруктураКонтрагентКт.Контрагент;
			    СтрокаПроводка.СубконтоКт.Договоры	   = СтруктураКонтрагентКт.Договор;
			КонецЕсли;		
			
		    СтрокаПроводка.Содержание = СтрокаМассива.Содержание;

		ИначеЕсли НайденныеСтроки.Количество() = 1 Тогда
			
			Для каждого СтрокаПроводка из Проводки Цикл
				Если СтрокаПроводка.Содержание = СтрокаМассива.Содержание Тогда
					Если СтрокаМассива.СчетКт = "91.01" И СтрокаПроводка.СубконтоДт.Контрагенты = КонтрагентПоиска
						ИЛИ НЕ СтрокаМассива.СчетКт = "91.01" И СтрокаПроводка.СубконтоКт.Контрагенты = КонтрагентПоиска Тогда
						СтрокаПроводка.Сумма	   = СтрокаМассива.Сумма;
			    		СтрокаПроводка.Организация = ТекущаяОрганизация.Ссылка;
			    		СтрокаПроводка.Период	   = ДатаДокумента; 
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;

		КонецЕсли;
				
		Если НЕ СтрокаМассива.СодержаниеКУДР = "" Тогда
			КУДРСтрока = КУДР.Добавить();
			КУДРСтрока.Активность	= Истина;
			КУДРСтрока.Графа4		= СтрокаМассива.Сумма;
			КУДРСтрока.Графа5		= СтрокаМассива.Сумма;
			КУДРСтрока.Содержание	= СтрокаМассива.СодержаниеКУДР;
			КУДРСтрока.Организация	= ТекущаяОрганизация;
			КУДРСтрока.Период		= ДатаДокумента; 
			ДобавленоСтрокКУДР = ДобавленоСтрокКУДР + 1;
		КонецЕсли;
		
		ОбработанныеСтроки.Добавить(СтруктураСтроки);
		
	КонецЦикла;
	
	Проводки.Записать();
	//Шихалиев Т.Р. 03.04.2026--
	КУДР.Записать();
	//Шихалиев Т.Р. 03.04.2026++
	ОбщаяСуммаПроводок = 0;
	Для каждого СтрокаПроводки Из Проводки Цикл
		ОбщаяСуммаПроводок = ОбщаяСуммаПроводок + СтрокаПроводки.Сумма;
	КонецЦикла;
	ДокументОбъект.СуммаОперации = ОбщаяСуммаПроводок;
	//Шихалиев Т.Р. 03.04.2026--
	ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	
	Для каждого СтрокаДвижение из ДокументОбъект.Движения Цикл
		Для Каждого Строка Из СтрокаДвижение Цикл
			Строка.Активность = Истина;
			СтрокаДвижение.Записывать = Истина;
		КонецЦикла;
	КонецЦикла;
	
	Результат.Вставить("ОбработанныеСтроки", ОбработанныеСтроки);

	Проводки = РегистрыБухгалтерии.Хозрасчетный.СоздатьНаборЗаписей();
	Проводки.Отбор.Регистратор.Установить(ДокументСсылка);
	Проводки.Прочитать();
	ТаблицаПроводок = Проводки.Выгрузить();
	
	Для каждого СтрокаМассива из МассивСтрокОперации Цикл  
		
		СтрокаОперации = Новый Структура();
		СтрокаОперации.Вставить("ДатаДокумента", 		Строка(ДатаДокумента));		
		СтрокаОперации.Вставить("Содержание", 			СтрокаМассива.Содержание);
		СтрокаОперации.Вставить("ВодительНаименование", СтрокаМассива.ВодительНаименование);
		СтрокаОперации.Вставить("ВыгружаемаяОперация", 	СтрокаМассива.ВыгружаемаяОперация);
		
		СтруктураПоиска = Новый Структура();
		СтруктураПоиска.Вставить("Содержание", СтрокаМассива.Содержание);
		СтруктураКонтрагентКт = НовыйПоискКонтрагентовИДоговоров(СтрокаМассива.КонтрагентКт, СтрокаМассива.КодВодителя, ТаблицаКонтрагентов);
		СтруктураПоиска.Вставить("СубконтоКт3", СтруктураКонтрагентКт.Контрагент);

		НайденныеСтроки = ТаблицаПроводок.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки.Количество() = 1 Тогда
			СтрокаОперации.Вставить("Добавлена", "Истина");
			СтрокаОперации.Вставить("КонтрагентДт", Строка(НайденныеСтроки[0].СубконтоДт3));
			СтрокаОперации.Вставить("КонтрагентКт", Строка(НайденныеСтроки[0].СубконтоКт3));
			СтрокаОперации.Вставить("Сумма", НайденныеСтроки[0].Сумма);
		Иначе
		    СтрокаОперации.Вставить("Добавлена", "Ложь");
		КонецЕсли;
				
		ОбработанныеСтроки.Добавить(СтрокаОперации);
	КонецЦикла;
	
	Результат.Вставить("ОбработанныеСтроки", ОбработанныеСтроки);
	Результат.Вставить("Статус", "Истина");
	ДополнитьРезультатЛогированияДокумента(Результат, ДокументОбъект, "Аренда", ДокументБылНайден);
	Возврат Результат;
	
КонецФункции

#endregion
 

#region ЗагрузкаОказаниеУслуг

Функция ПолучитьМассивОказаниеУслуг(СтруктураОтбора)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОказаниеУслуг.Дата КАК Дата,
		|	ОказаниеУслуг.Номер КАК Номер,
		|	ОказаниеУслугКонтрагенты.Контрагент КАК Контрагент,
		|	ОказаниеУслугКонтрагенты.Сумма КАК Сумма,
		|	ЕСТЬNULL(КодВодителяКонтрагента.Значение, """") КАК КодВодителя
		|ИЗ
		|	Документ.ОказаниеУслуг.Контрагенты КАК ОказаниеУслугКонтрагенты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОказаниеУслуг КАК ОказаниеУслуг
		|		ПО ОказаниеУслугКонтрагенты.Ссылка = ОказаниеУслуг.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК КодВодителяКонтрагента
		|		ПО ОказаниеУслугКонтрагенты.Контрагент = КодВодителяКонтрагента.Объект
		|			И (КодВодителяКонтрагента.Свойство.Наименование = ""КодВодителя"")
		|ГДЕ
		|	ОказаниеУслуг.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&ДатаНачала, МЕСЯЦ) И КОНЕЦПЕРИОДА(&ДатаОкончания, МЕСЯЦ)
		|	И ОказаниеУслуг.Проведен = ИСТИНА";
	
	Запрос.УстановитьПараметр("ДатаНачала", 	СтруктураОтбора.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", 	КонецДня(СтруктураОтбора.ДатаОкончания));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	МассивДокументов = Новый Массив;
	
	Пока Выборка.Следующий() Цикл		
		СтруктураДокумент = Новый Структура("Номер, Сумма, КодВодителя");
		ЗаполнитьЗначенияСвойств(СтруктураДокумент, Выборка);  
		СтруктураДокумент.Вставить("Дата", 					Строка(Выборка.Дата));
		СтруктураДокумент.Вставить("Контрагент", 			Строка(Выборка.Контрагент));
		МассивДокументов.Добавить(СтруктураДокумент);
	КонецЦикла;	
	
	Возврат МассивДокументов;	
	
КонецФункции

Функция ПолучитьДокументыОказаниеУслугЗаПериод(СтруктураПараметров)
	
	Если СтруктураПараметров.Свойство("ДатаНачала") Тогда
			
		ДатаНачала 		= ДатаИзСтроки(СтруктураПараметров.ДатаНачала);
		ДатаОкончания 	= ДатаИзСтроки(СтруктураПараметров.ДатаОкончания);
		СтруктураОтбора = Новый Структура("ДатаНачала, ДатаОкончания", ДатаНачала, ДатаОкончания);
		
		МассивДокументов = ПолучитьМассивОказаниеУслуг(СтруктураОтбора);

		СтруктураОтвета = Новый Структура();
		СтруктураОтвета.Вставить("Статус", "Истина");
		СтруктураОтвета.Вставить("ДатаЗапретаИзменения"		, Строка(ПолучитьДатуЗапретаИзменения()));
		СтруктураОтвета.Вставить("Отладка", "Истина");
		СтруктураОтвета.Вставить("МассивОказаниеУслуг", 		МассивДокументов);
			
		Возврат СтруктураОтвета;
		
	КонецЕсли;
	
	СтруктураОтвета = Новый Структура();
	СтруктураОтвета.Вставить("ТестовыйПараметр", "ДокументыЭквайринг2");
		
	Возврат СтруктураОтвета;
	
КонецФункции

Функция ПоискДокументаОказаниеУслуг(ДатаДокумента)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Организации.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТ_Организации
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	Организации.ПометкаУдаления = ЛОЖЬ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОказаниеУслуг.Номер КАК Номер,
		|	ОказаниеУслуг.Дата КАК Дата,
		|	ОказаниеУслуг.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТ_ДокументыОтобранные
		|ИЗ
		|	Документ.ОказаниеУслуг КАК ОказаниеУслуг
		|ГДЕ
		|	ОказаниеУслуг.Организация В
		|			(ВЫБРАТЬ
		|				ВТ_Организации.Ссылка КАК Ссылка
		|			ИЗ
		|				ВТ_Организации КАК ВТ_Организации)
		|	И ОказаниеУслуг.Дата = &ДатаДокумента
		|	И ОказаниеУслуг.ПометкаУдаления = ЛОЖЬ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ДокументыОтобранные.Ссылка КАК Ссылка
		|ИЗ
		|	ВТ_ДокументыОтобранные КАК ВТ_ДокументыОтобранные";
	
	Запрос.УстановитьПараметр("ДатаДокумента", 	ДатаДокумента);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Документы.ОказаниеУслуг.ПустаяСсылка();
	
КонецФункции

Функция СоздатьДокументыОказаниеУслуг(СтруктураПараметров)
	
	Если СтруктураПараметров.Свойство("МассивДокументов") Тогда
		
		СтруктураПоискаКонтрагентов = ОбработатьКонтрагентовИДоговоры(СтруктураПараметров);	
		
		ТаблицаКонтрагентов = СтруктураПоискаКонтрагентов.ТаблицаКонтрагентов;	
		
		СтруктураОтвета = Новый Структура();
		
		СтруктураДокумент = СоздатьДокументОказаниеУслуг(СтруктураПараметров.МассивДокументов, ТаблицаКонтрагентов);
		ДополнитьРезультатЛогированияОперации(СтруктураДокумент, "ОказаниеУслуг");
		
		
		СтруктураОтвета.Вставить("МассивКонтрагентов", 				ПреобразоватьТаблицуВМассивСтрокДляВыгрузки(ТаблицаКонтрагентов, Истина));
		
		СтруктураОтвета.Вставить("РезультатСоздания", СтруктураДокумент);
		
	Иначе
		СтруктураОтвета = Новый Структура();
		СтруктураОтвета.Вставить("ТестовыйПараметр", "ДокументыЭквайринг2");
	КонецЕсли; 
