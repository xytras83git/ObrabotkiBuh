Функция ПолучитьМассивОСАГО(СтруктураОтбора)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПоступлениеТоваровУслуг.Номер КАК Номер,
		|	ПоступлениеТоваровУслуг.Дата КАК Дата,
		|	ПоступлениеТоваровУслугУслуги.Сумма КАК Сумма,
		|	ПоступлениеТоваровУслуг.Контрагент КАК Контрагент,
		|	ПоступлениеТоваровУслуг.Ссылка КАК Ссылка,
		|	ВЫБОР
		|		КОГДА ПОДСТРОКА(ПоступлениеТоваровУслугУслуги.Субконто1.Наименование, 16, 1) = ""с""
		|				И НЕ ПОДСТРОКА(ПоступлениеТоваровУслугУслуги.Субконто1.Наименование, 15, 1) = "" ""
		|			ТОГДА ПОДСТРОКА(ПоступлениеТоваровУслугУслуги.Субконто1.Наименование, 7, 9)
		|		КОГДА ПОДСТРОКА(ПоступлениеТоваровУслугУслуги.Субконто1.Наименование, 16, 1) = ""с""
		|				И ПОДСТРОКА(ПоступлениеТоваровУслугУслуги.Субконто1.Наименование, 15, 1) = "" ""
		|			ТОГДА ПОДСТРОКА(ПоступлениеТоваровУслугУслуги.Субконто1.Наименование, 7, 8)
		|		КОГДА ПОДСТРОКА(ПоступлениеТоваровУслугУслуги.Субконто1.Наименование, 17, 1) = ""с""
		|				И ПОДСТРОКА(ПоступлениеТоваровУслугУслуги.Субконто1.Наименование, 16, 1) = "" ""
		|			ТОГДА ПОДСТРОКА(ПоступлениеТоваровУслугУслуги.Субконто1.Наименование, 7, 9)
		|		КОГДА ПОДСТРОКА(ПоступлениеТоваровУслугУслуги.Субконто1.Наименование, 15, 1) = ""с""
		|				И ПОДСТРОКА(ПоступлениеТоваровУслугУслуги.Субконто1.Наименование, 14, 1) = "" ""
		|			ТОГДА ПОДСТРОКА(ПоступлениеТоваровУслугУслуги.Субконто1.Наименование, 7, 7)
		|		ИНАЧЕ ПОДСТРОКА(ПоступлениеТоваровУслугУслуги.Субконто1.Наименование, 15, 1)
		|	КОНЕЦ КАК Госномер,
		|	ДоговорыКонтрагентов.Наименование КАК ДоговорНаименование
		|ПОМЕСТИТЬ ВТ_МассивДокументов
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг.Услуги КАК ПоступлениеТоваровУслугУслуги
		|		ПО ПоступлениеТоваровУслуг.Ссылка = ПоступлениеТоваровУслугУслуги.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|		ПО ПоступлениеТоваровУслуг.ДоговорКонтрагента = ДоговорыКонтрагентов.Ссылка
		|ГДЕ
		|	ПоступлениеТоваровУслуг.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&ДатаНачала, МЕСЯЦ) И ДОБАВИТЬКДАТЕ(КОНЕЦПЕРИОДА(&ДатаОкончания, МЕСЯЦ), МЕСЯЦ, 1)
		|	И ПоступлениеТоваровУслугУслуги.Номенклатура.Наименование = ""ОСАГО""
		|	И ПоступлениеТоваровУслуг.Проведен = ИСТИНА
		|	И ПоступлениеТоваровУслуг.Организация = &Организация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_МассивДокументов.Госномер КАК Госномер,
		|	СУММА(1) КАК КоличествоЗадвоенных
		|ИЗ
		|	ВТ_МассивДокументов КАК ВТ_МассивДокументов
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_МассивДокументов.Госномер
		|
		|ИМЕЮЩИЕ
		|	СУММА(1) > 1";
	
	Запрос.УстановитьПараметр("Организация", 	СтруктураОтбора.Организация);
	Запрос.УстановитьПараметр("ДатаНачала", 	СтруктураОтбора.ДатаНачала); 
	Запрос.УстановитьПараметр("ДатаОкончания", 	КонецДня(СтруктураОтбора.ДатаОкончания));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТаблицаЗадвоений = РезультатЗапроса.Выгрузить();
	ТаблицаДокументов = ПолучитьВТ(Запрос.МенеджерВременныхТаблиц, "ВТ_МассивДокументов");
	МассивДокументов = ПреобразоватьТаблицуВМассивСтрокДляВыгрузки(ТаблицаДокументов, Истина);
	
	Результат = Новый Структура("МассивДокументов", МассивДокументов);
	Если ТаблицаЗадвоений.Количество() > 0 Тогда
		Результат.Вставить("МассивЗадвоений", ТаблицаЗадвоений.ВыгрузитьКолонку("Госномер"));
	КонецЕсли;
	
	Возврат Результат;	
	
КонецФункции

Функция ПолучитьДокументыОСАГОЗаПериод(СтруктураПараметров)
	
	Если СтруктураПараметров.Свойство("ДатаНачала") Тогда
			
		ДатаНачала 		= ДатаИзСтроки(СтруктураПараметров.ДатаНачала);
		ДатаОкончания 	= ДатаИзСтроки(СтруктураПараметров.ДатаОкончания);
		Организация = Справочники.Организации.НайтиПоРеквизиту("ИНН", СтруктураПараметров.ИННОрганизации);
		СтруктураОтбора = Новый Структура("ДатаНачала, ДатаОкончания, Организация", ДатаНачала, ДатаОкончания, Организация);
		
		СтруктураДокументов = ПолучитьМассивОСАГО(СтруктураОтбора);
		
		СтруктураОтвета = Новый Структура();
		СтруктураОтвета.Вставить("Статус", 					"Истина");
		СтруктураОтвета.Вставить("ДатаЗапретаИзменения", 	Строка(ПолучитьДатуЗапретаИзменения()));
		СтруктураОтвета.Вставить("Отладка", 				"Истина");
		СтруктураОтвета.Вставить("МассивОСАГО", 			СтруктураДокументов.МассивДокументов);
		Если СтруктураДокументов.Свойство("МассивЗадвоений") Тогда
			СтруктураОтвета.Вставить("МассивЗадвоений", 	СтруктураДокументов.МассивЗадвоений);
		КонецЕсли;
			
		Возврат СтруктураОтвета;
		
	КонецЕсли;
	
	СтруктураОтвета = Новый Структура();
	СтруктураОтвета.Вставить("ТестовыйПараметр", "ДокументыЭквайринг2");
		
	Возврат СтруктураОтвета;
	
КонецФункции  

Функция СоздатьДокументыОСАГО(СтруктураПараметров)
	
	Если СтруктураПараметров.Свойство("МассивДокументов") Тогда
		
		СтруктураОтвета = Новый Структура();
		
		РезультатСоздания = Новый Структура();
		МассивОтветов = Новый Массив;
		Для каждого СтрокаДокумент из СтруктураПараметров.МассивДокументов Цикл
			СтруктураДокумента = СоздатьДокументОСАГО(СтрокаДокумент);
			ДополнитьРезультатЛогированияОперации(СтруктураДокумента, "ОСАГО");
			МассивОтветов.Добавить(СтруктураДокумента);
		КонецЦикла;
		РезультатСоздания.Вставить("МассивОтветов", 	МассивОтветов);
		
		СтруктураОтвета.Вставить("РезультатСоздания", РезультатСоздания);
	Иначе
		СтруктураОтвета = Новый Структура();
		СтруктураОтвета.Вставить("ТестовыйПараметр", "ДокументыЭквайринг2");
	КонецЕсли;
	
	Возврат СтруктураОтвета;	
	
	
КонецФункции

