//Torbyak 28.09.2026++
&НаКлиенте
Процедура ПроверитьЗапись(Команда)
	ПрименитьДанныеЗаписи(ПолучитьДанныеЗаписиНаСервере());
КонецПроцедуры

&НаКлиенте
Процедура УдалитьЗапись(Команда)
	ДанныеЗаписи = ПолучитьДанныеЗаписиНаСервере();
	ПрименитьДанныеЗаписи(ДанныеЗаписи);
	
	Если Не ДанныеЗаписи.ЗаписьНайдена Тогда
		Предупреждение(ДанныеЗаписи.Сообщение);
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = СтрШаблон(
		"Удалить запись активности пользователя %1 по организации %2?",
		Пользователь,
		Организация);
	Ответ = Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Нет);
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	РезультатУдаления = УдалитьЗаписьНаСервере();
	Предупреждение(РезультатУдаления.Сообщение);
	ПрименитьДанныеЗаписи(ПолучитьДанныеЗаписиНаСервере());
КонецПроцедуры
