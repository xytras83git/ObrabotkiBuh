//Torbyak 28.09.2026++
&НаСервере
Функция ПолучитьДанныеЗаписиНаСервере()
	
	Результат = Новый Структура;
	Результат.Вставить("ЗаписьНайдена", Ложь);
	Результат.Вставить("ДатаПоследнейАктивности", Дата(1, 1, 1));
	Результат.Вставить("ДатаПоследнейАктивностиУниверсальная", Дата(1, 1, 1));
	Результат.Вставить("ПредставлениеДокумента", "");
	Результат.Вставить("Сообщение", "Укажите организацию и пользователя.");
	
	Если Не ЗначениеЗаполнено(Организация) Или Не ЗначениеЗаполнено(Пользователь) Тогда
		Возврат Результат;
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.АктивностьСеансовПользователей.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Организация = Организация;
	МенеджерЗаписи.Пользователь = Пользователь;
	МенеджерЗаписи.Прочитать();
	
	Если Не МенеджерЗаписи.Выбран() Тогда
		Результат.Сообщение = "Запись по выбранным организации и пользователю не найдена.";
		Возврат Результат;
	КонецЕсли;
	
	Результат.ЗаписьНайдена = Истина;
	Результат.ДатаПоследнейАктивности = МенеджерЗаписи.ДатаПоследнейАктивности;
	Результат.ДатаПоследнейАктивностиУниверсальная = МенеджерЗаписи.ДатаПоследнейАктивностиУниверсальная;
	Результат.ПредставлениеДокумента = Строка(МенеджерЗаписи.Документ);
	Результат.Сообщение = "Запись найдена.";
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция УдалитьЗаписьНаСервере()
	
	Результат = Новый Структура("Удалено,Сообщение", Ложь, "Укажите организацию и пользователя.");
	Если Не ЗначениеЗаполнено(Организация) Или Не ЗначениеЗаполнено(Пользователь) Тогда
		Возврат Результат;
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.АктивностьСеансовПользователей.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Организация = Организация;
	МенеджерЗаписи.Пользователь = Пользователь;
	МенеджерЗаписи.Прочитать();
	
	Если Не МенеджерЗаписи.Выбран() Тогда
		Результат.Сообщение = "Запись уже отсутствует.";
		Возврат Результат;
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.АктивностьСеансовПользователей.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Организация.Установить(Организация);
	НаборЗаписей.Прочитать();
	КоличествоУдаляемыхЗаписей = НаборЗаписей.Количество();
	
	ГраницаАктивности = ТекущаяУниверсальнаяДата() - МинимальныйВозрастМинут * 60;
	Для Каждого ЗаписьАктивности Из НаборЗаписей Цикл
		Если ЗаписьАктивности.ДатаПоследнейАктивностиУниверсальная >= ГраницаАктивности Тогда
			Результат.Сообщение = СтрШаблон(
				"Удаление запрещено: у пользователя %1 активность зарегистрирована менее %2 минут назад.",
				ЗаписьАктивности.Пользователь,
				МинимальныйВозрастМинут);
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;

	РегистрыСведений.АктивностьСеансовПользователей.УдалитьАктивностьПользователейПоОрганизации(Организация);

	Контроль = РегистрыСведений.АктивностьСеансовПользователей.СоздатьНаборЗаписей();
	Контроль.Отбор.Организация.Установить(Организация);
	Контроль.Прочитать();
	
	Если Контроль.Количество() > 0 Тогда
		Результат.Сообщение = "После штатной очистки в регистре остались записи по организации.";
		Возврат Результат;
	КонецЕсли;
	
	Результат.Удалено = Истина;
	Результат.Сообщение = СтрШаблон("Удалено записей активности организации: %1.", КоличествоУдаляемыхЗаписей);
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПрименитьДанныеЗаписи(ДанныеЗаписи)
	ЗаписьНайдена = ДанныеЗаписи.ЗаписьНайдена;
	ДатаПоследнейАктивности = ДанныеЗаписи.ДатаПоследнейАктивности;
	ДатаПоследнейАктивностиУниверсальная = ДанныеЗаписи.ДатаПоследнейАктивностиУниверсальная;
	ПредставлениеДокумента = ДанныеЗаписи.ПредставлениеДокумента;
	СостояниеЗаписи = ДанныеЗаписи.Сообщение;
	Элементы.УдалитьЗаписьКнопка.Доступность = ЗаписьНайдена;
КонецПроцедуры

&НаСервере
Процедура ОчиститьПредставлениеЗаписи()
	ЗаписьНайдена = Ложь;
	ДатаПоследнейАктивности = Дата(1, 1, 1);
	ДатаПоследнейАктивностиУниверсальная = Дата(1, 1, 1);
	ПредставлениеДокумента = "";
	СостояниеЗаписи = "Укажите организацию и пользователя, затем нажмите Проверить.";
	Элементы.УдалитьЗаписьКнопка.Доступность = Ложь;
КонецПроцедуры
